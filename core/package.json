{
  "name": "@anvil/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./antipattern": {
      "types": "./dist/antipattern/index.d.ts",
      "import": "./dist/antipattern/index.js"
    },
    "./suppression": {
      "types": "./dist/suppression/index.d.ts",
      "import": "./dist/suppression/index.js"
    }
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "generate:schema": "tsx scripts/generate-json-schema.ts"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.2",
    "js-yaml": "^4.1.1",
    "minimatch": "^10.1.1",
    "safe-regex2": "^5.0.0",
    "shell-quote": "^1.8.2",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/json-schema": "^7.0.15",
    "@types/shell-quote": "^1.7.5",
    "tsx": "^4.21.0",
    "vitest": "^4.0.16"
  }
}
