{
  "title": "Watch Session",
  "description": "Dashboard for an active anvil watch session — shows session status, file monitoring metrics, recent change events, and current check progress.",
  "version": "1.0",
  "root": "page",
  "elements": {
    "page": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "lg"
      },
      "children": [
        "header",
        "metrics-row",
        "separator-1",
        "progress-section",
        "separator-2",
        "events-section"
      ]
    },
    "header": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "md",
        "align": "center",
        "justify": "between"
      },
      "children": ["title", "session-status"]
    },
    "title": {
      "type": "Heading",
      "props": {
        "children": "Watch Session",
        "level": 2
      },
      "children": []
    },
    "session-status": {
      "type": "StatusBadge",
      "props": {
        "status": "info",
        "label": "Watching: running (pid 48231)"
      },
      "children": []
    },
    "metrics-row": {
      "type": "Grid",
      "props": {
        "columns": 3,
        "gap": "md"
      },
      "children": ["metric-files", "metric-events", "metric-last-result"]
    },
    "metric-files": {
      "type": "MetricCard",
      "props": {
        "label": "Files Watched",
        "value": "342",
        "format": "number"
      },
      "children": []
    },
    "metric-events": {
      "type": "MetricCard",
      "props": {
        "label": "Events Processed",
        "value": "17",
        "trend": "up",
        "format": "number"
      },
      "children": []
    },
    "metric-last-result": {
      "type": "MetricCard",
      "props": {
        "label": "Last Check Result",
        "value": "pass"
      },
      "children": []
    },
    "separator-1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      },
      "children": []
    },
    "progress-section": {
      "type": "Card",
      "props": {
        "title": "Current Check",
        "description": "Running gate checks triggered by file change"
      },
      "children": ["progress-stack"]
    },
    "progress-stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": ["progress-bar", "progress-detail"]
    },
    "progress-bar": {
      "type": "Progress",
      "props": {
        "value": 6,
        "max": 7,
        "label": "Checks complete: 6 of 7"
      },
      "children": []
    },
    "progress-detail": {
      "type": "Text",
      "props": {
        "children": "Running: architecture (check 7 of 7)...",
        "variant": "muted"
      },
      "children": []
    },
    "separator-2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      },
      "children": []
    },
    "events-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": ["events-heading", "events-table"]
    },
    "events-heading": {
      "type": "Heading",
      "props": {
        "children": "Recent File Events",
        "level": 3
      },
      "children": []
    },
    "events-table": {
      "type": "Table",
      "props": {
        "columns": ["Timestamp", "File", "Detail"],
        "rows": [
          [
            "14:32:08",
            "packages/anvil/runtime/src/gate/checks/policy.check.ts",
            "boundary violation: runtime-must-not-import-edda-internals"
          ],
          [
            "14:31:55",
            "packages/anvil/runtime/src/gate/checks/dependency.check.ts",
            "boundary violation: runtime-prefer-contracts-path"
          ],
          [
            "14:31:42",
            "packages/anvil/runtime/src/gate/checks/antipattern.check.ts",
            "check passed"
          ],
          ["14:30:19", "packages/anvil/core/src/config/loader.ts", "check passed"],
          [
            "14:29:03",
            "packages/anvil/runtime/src/gate/checks/command-safety.check.ts",
            "check passed"
          ],
          ["14:28:47", ".anvil/gate.config.json", "debounced"],
          ["14:27:31", "packages/anvil/runtime/src/watch/git-status.test.ts", "check passed"]
        ],
        "caption": "Showing last 7 events (17 total this session)"
      },
      "children": []
    }
  }
}
