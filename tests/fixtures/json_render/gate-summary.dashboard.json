{
  "title": "Gate Summary",
  "description": "Dashboard for anvil gate run results — shows overall pass/fail status, check metrics, individual check results, and warnings.",
  "version": "1.0",
  "root": "page",
  "elements": {
    "page": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "lg"
      },
      "children": ["header", "metrics-row", "separator-1", "checks-section", "warnings-section"]
    },
    "header": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "md",
        "align": "center",
        "justify": "between"
      },
      "children": ["title", "gate-status"]
    },
    "title": {
      "type": "Heading",
      "props": {
        "children": "Gate Run Summary",
        "level": 2
      },
      "children": []
    },
    "gate-status": {
      "type": "StatusBadge",
      "props": {
        "status": "pass",
        "label": "Gate: PASSED (score 92/100)"
      },
      "children": []
    },
    "metrics-row": {
      "type": "Grid",
      "props": {
        "columns": 3,
        "gap": "md"
      },
      "children": ["metric-checks-run", "metric-warnings", "metric-duration"]
    },
    "metric-checks-run": {
      "type": "MetricCard",
      "props": {
        "label": "Checks Run",
        "value": "7",
        "format": "number"
      },
      "children": []
    },
    "metric-warnings": {
      "type": "MetricCard",
      "props": {
        "label": "Warnings Found",
        "value": "2",
        "trend": "down",
        "format": "number"
      },
      "children": []
    },
    "metric-duration": {
      "type": "MetricCard",
      "props": {
        "label": "Gate Duration (s)",
        "value": "42",
        "format": "duration"
      },
      "children": []
    },
    "separator-1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      },
      "children": []
    },
    "checks-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": ["checks-heading", "checks-table"]
    },
    "checks-heading": {
      "type": "Heading",
      "props": {
        "children": "Individual Check Results",
        "level": 3
      },
      "children": []
    },
    "checks-table": {
      "type": "Table",
      "props": {
        "columns": ["Check", "Status", "Score", "Message"],
        "rows": [
          ["lint", "passed", "100", "No lint errors"],
          ["test", "passed", "100", "All tests passed"],
          ["coverage", "passed", "72", "Coverage 72% — threshold is 70% (close to limit)"],
          ["dependency", "passed", "95", "All dependencies within policy bounds"],
          ["secret", "passed", "100", "No hardcoded secrets found"],
          ["architecture", "passed", "85", "No boundary violations in changed files"],
          ["policy", "passed", "90", "All active policies satisfied"]
        ],
        "caption": "7 checks executed against current staged changes"
      },
      "children": []
    },
    "warnings-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": ["warnings-heading", "warning-coverage", "warning-dependency"]
    },
    "warnings-heading": {
      "type": "Heading",
      "props": {
        "children": "Warnings",
        "level": 3
      },
      "children": []
    },
    "warning-coverage": {
      "type": "Alert",
      "props": {
        "title": "Test coverage nearing threshold",
        "message": "Coverage is 72% (threshold: 70%). Consider adding tests for packages/anvil/runtime/src/gate/checks/policy.check.ts to maintain margin.",
        "type": "warning"
      },
      "children": []
    },
    "warning-dependency": {
      "type": "Alert",
      "props": {
        "title": "Dependency audit: minor version drift",
        "message": "2 transitive dependencies have patch updates available. Gate passed but consider running pnpm update to stay current.",
        "type": "info"
      },
      "children": []
    }
  }
}
