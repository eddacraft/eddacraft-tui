{
  "name": "website",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/website",
  "targets": {
    "dev": {
      "command": "next dev",
      "options": {
        "cwd": "apps/website"
      }
    },
    "build": {
      "command": "next build",
      "options": {
        "cwd": "apps/website"
      }
    },
    "start": {
      "command": "next start",
      "options": {
        "cwd": "apps/website"
      }
    },
    "test": {
      "command": "node node_modules/vitest/vitest.mjs run apps/website --passWithNoTests=false"
    }
  }
}
