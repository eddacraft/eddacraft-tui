{
  "name": "@eddacraft/anvil-api",
  "version": "0.4.0-beta",
  "description": "Beta access API for Anvil — Hono on Vercel with Neon Postgres",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc --build",
    "postbuild": "node scripts/check-runtime-cjs.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "check:runtime-cjs": "node scripts/check-runtime-cjs.cjs",
    "dev": "npx wrangler dev src/index.ts"
  },
  "repository": {
    "type": "git",
