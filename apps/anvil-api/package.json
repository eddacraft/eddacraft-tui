    "directory": "apps/anvil-api"
  },
  "author": "eddacraft",
  "dependencies": {
    "@eddacraft/admin-contracts": "workspace:*",
    "@eddacraft/anvil-contracts": "workspace:*",
    "@eddacraft/anvil-runtime": "workspace:*",
    "@eddacraft/transactional": "workspace:*",
    "@hono/zod-validator": "^0.7.0",
    "@neondatabase/serverless": "^1.1.0",
    "hono": "^4.12.14",
    "jose": "^6.2.2",
    "resend": "^6.12.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "~6.0.3"
  }
}
