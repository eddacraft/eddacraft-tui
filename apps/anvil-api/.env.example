# Neon Postgres connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Bearer token for admin endpoints (generate with: openssl rand -base64 48)
ADMIN_KEY=your-admin-key-here

# Optional: extra secret mixed into token hashing
TOKEN_PEPPER=your-pepper-here

# GitHub OAuth app used by docs-shell browser sign-in and the API callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Dedicated GitHub OAuth app used by the Anvil CLI device flow
GITHUB_CLI_CLIENT_ID=
GITHUB_CLI_CLIENT_SECRET=
