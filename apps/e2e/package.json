{
  "name": "@eddacraft/anvil-e2e",
  "version": "0.3.0-beta",
  "private": true,
  "description": "End-to-end test harness for all Anvil surfaces",
  "type": "module",
  "scripts": {
    "pretest": "pnpm --filter @eddacraft/transactional build",
    "test": "vitest run",
    "pretest:watch": "pnpm --filter @eddacraft/transactional build",
    "test:watch": "vitest",
    "pretest:smoke": "pnpm --filter @eddacraft/transactional build",
    "test:smoke": "vitest run smoke",
    "test:cli": "vitest run cli",
    "pretest:api": "pnpm --filter @eddacraft/transactional build",
    "test:api": "vitest run api",
    "test:core": "vitest run core",
    "test:contracts": "vitest run contracts",
    "test:adapters": "vitest run adapters",
    "test:mcp": "vitest run mcp"
  },
  "dependencies": {
    "@eddacraft/anvil-core": "workspace:*",
    "@eddacraft/anvil-runtime": "workspace:*",
    "@eddacraft/anvil-aps": "workspace:*",
    "@eddacraft/anvil-adapters": "workspace:*",
    "@eddacraft/anvil-mcp-server": "workspace:*",
    "@eddacraft/anvil-edda-stack": "workspace:*",
    "hono": "^4.12.14",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "vitest": "^4.1.4",
    "typescript": "~6.0.3"
  }
}
