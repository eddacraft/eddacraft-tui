{
  "name": "@eddacraft/anvil-e2e",
  "version": "0.3.0-beta",
  "private": true,
  "description": "End-to-end test harness for all Anvil surfaces",
  "type": "module",
  "scripts": {
    "pretest": "pnpm --filter '@eddacraft/anvil-api^...' build",
    "test": "vitest run",
    "pretest:watch": "pnpm --filter '@eddacraft/anvil-api^...' build",
    "test:watch": "vitest",
    "pretest:smoke": "pnpm --filter '@eddacraft/anvil-api^...' build",
    "test:smoke": "vitest run smoke",
    "test:cli": "vitest run cli",
    "pretest:api": "pnpm --filter '@eddacraft/anvil-api^...' build",
    "test:api": "vitest run api",
    "test:core": "vitest run core",
    "test:contracts": "vitest run contracts",
    "test:adapters": "vitest run adapters"
  },
  "dependencies": {
    "@eddacraft/anvil-adapters": "workspace:*",
    "@eddacraft/anvil-aps": "workspace:*",
    "@eddacraft/anvil-core": "workspace:*",
    "@eddacraft/anvil-edda-stack": "workspace:*",
    "@eddacraft/anvil-runtime": "workspace:*",
    "hono": "^4.12.28",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "jose": "^6.2.3",
    "typescript": "~6.0.3",
    "vitest": "^4.1.8"
  }
}
