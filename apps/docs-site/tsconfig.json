{
  // This file is not used in compilation. It is here just for a nice editor experience.
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    "baseUrl": ".",
    "customConditions": ["@eddacraft/anvil-source"],
    "paths": {
      "@eddacraft/anvil-contracts": ["../../packages/anvil/contracts/dist/index.d.ts"],
      "@eddacraft/anvil-flags-catalogue": ["../../packages/anvil/flags-catalogue/dist/index.d.ts"],
      "@eddacraft/anvil-runtime": ["../../packages/anvil/runtime/dist/index.d.ts"],
      "@eddacraft/anvil-runtime/*": ["../../packages/anvil/runtime/dist/*/index.d.ts"]
    },
    // @docusaurus/tsconfig enables baseUrl (deprecated in TS 6.0) and a non-default
    // module interop configuration. We mirror that here for editor-only tooling and
    // suppress the TS 6.0 deprecation warnings until Docusaurus updates its tsconfig.
    "ignoreDeprecations": "6.0"
  },
  "exclude": [".docusaurus", "build"],
  "references": [
    {
      "path": "../../packages/anvil/runtime"
    },
    {
      "path": "../../packages/anvil/contracts"
    },
    {
      "path": "../../packages/anvil/flags-catalogue"
    }
  ]
}
