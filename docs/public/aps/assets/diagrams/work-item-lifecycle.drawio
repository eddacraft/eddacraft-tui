        <mxCell id="continue" parent="1" style="rounded=1;html=0;arcSize=20;strokeWidth=1;strokeColor=#26836A;fillColor=#F3FBF8;fontColor=#174F41;fontSize=14;fontStyle=1;align=center;" value="Continue the queue with aps lint and aps next" vertex="1">
          <mxGeometry height="52" width="400" x="370" y="270" as="geometry" />
        </mxCell>
        <mxCell id="edge-loop" edge="1" parent="1" source="complete" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeWidth=2;strokeColor=#26836A;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" target="next" value="">
