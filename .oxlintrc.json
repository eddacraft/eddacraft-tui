{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "warn",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-unused-vars": "off",
    "no-explicit-any": "off",
    "no-await-in-loop": "off",
    "no-shadow": "off",
    "no-new": "off",
    "no-underscore-dangle": "off",
    "unicorn/no-array-sort": "off",
    "unicorn/consistent-function-scoping": "off"
  },
  "ignorePatterns": [
    "dist/",
    "node_modules/",
    ".nx/",
    "coverage/",
    ".next/",
    ".vercel/",
    "build/",
    ".claude/",
    "archive/"
  ]
}
