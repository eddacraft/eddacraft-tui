<mxfile host="Electron" version="31.1.8" anvil-title="Sample flow" anvil-description="A request moves from input to output.">
  <diagram id="sample-flow" name="Page-1">
    <mxGraphModel dx="1000" dy="700" grid="1" page="1" pageWidth="827" pageHeight="1169">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="input" value="Input" style="rounded=1;whiteSpace=wrap;html=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="output" value="Output" style="rounded=1;whiteSpace=wrap;html=0;" vertex="1" parent="1">
          <mxGeometry x="240" y="40" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="edge" edge="1" parent="1" source="input" target="output">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
