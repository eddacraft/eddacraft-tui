[Unit]
Description=APS cleanup — reconcile APS state and perform hygiene checks
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Projects/src/anvil-001
ExecStart=%h/Projects/src/anvil-001/scripts/aps-cleanup.sh --notify
Environment=REPO=%h/Projects/src/anvil-001
StandardOutput=journal
StandardError=journal
