[Unit]
Description=APS cleanup — verify Committed items, run post-merge test plans
After=network-online.target

[Service]
Type=oneshot
User=aneki
WorkingDirectory=%h/Projects/src/eddacraft
ExecStart=%h/Projects/src/eddacraft/scripts/aps-cleanup.sh --notify
Environment=REPO=%h/Projects/src/eddacraft
StandardOutput=journal
StandardError=journal
