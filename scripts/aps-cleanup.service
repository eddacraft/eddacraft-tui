[Unit]
Description=APS cleanup — verify Committed items, run post-merge test plans
After=network-online.target

[Service]
Type=oneshot
User=aneki
WorkingDirectory=/home/aneki/Projects/src/eddacraft
ExecStart=/home/aneki/Projects/src/eddacraft/scripts/aps-cleanup.sh --notify
Environment=REPO=/home/aneki/Projects/src/eddacraft
