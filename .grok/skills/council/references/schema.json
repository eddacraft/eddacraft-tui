{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Council Review Session Schema",
  "description": "Data model for local-first Council review sessions, findings, evidence, and publication",

  "definitions": {
    "session": {
      "type": "object",
      "description": "A Council review session — the top-level container for a review",
      "required": ["id", "mode", "status", "target", "reviewerPack", "createdAt"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^council-[a-f0-9]{8}$",
          "description": "Unique session identifier (council-{8 hex chars})"
        },
        "mode": {
          "type": "string",
          "enum": ["streaming", "batch", "design", "assurance"],
          "description": "Review mode. `design` challenges planning/architecture before code; `assurance` broadens post-verification review. `streaming`/`batch` remain valid historical execution modes (ADR-0025)."
        },
        "status": {
          "type": "string",
          "enum": ["active", "paused", "converged", "published", "abandoned"],
          "description": "Session lifecycle state"
        },
        "target": {
          "$ref": "#/definitions/reviewTarget"
        },
        "reviewerPack": {
          "type": "string",
          "enum": ["quick", "standard", "full", "full:codex", "risk-selected"],
          "description": "Reviewer pack used for this session. `risk-selected` records lenses chosen by domain/risk rather than a fixed pack (ADR-0025)."
        },
        "reviewers": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Agent names that participated in review"
        },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/definitions/finding" },
          "description": "All findings in this session"
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/definitions/evidence" },
          "description": "Validation evidence attached to this session"
        },
        "waivers": {
          "type": "array",
          "items": { "$ref": "#/definitions/waiver" },
          "description": "Accepted-risk waivers"
        },
        "events": {
          "type": "array",
          "items": { "$ref": "#/definitions/sessionEvent" },
          "description": "Chronological event log"
        },
        "judgeResult": {
          "$ref": "#/definitions/judgeResult",
          "description": "Recorded judge outcome for this session's candidate (ADR-0025)"
        },
        "summary": {
          "$ref": "#/definitions/publicationSummary",
          "description": "Generated publication summary (populated on publish)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "convergedAt": {
          "type": "string",
          "format": "date-time"
        },
        "parentSession": {
          "type": "string",
          "description": "ID of parent session if this is a continuation/escalation"
        }
      }
    },

    "reviewTarget": {
      "type": "object",
      "description": "What is being reviewed",
      "required": ["type", "baseRevision", "headRevision", "treeDigest"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["worktree", "staged", "branch", "files", "commit"],
          "description": "Target scope"
        },
        "branch": {
          "type": "string",
          "description": "Branch name (for branch targets)"
        },
        "baseBranch": {
          "type": "string",
          "description": "Base branch for comparison"
        },
        "files": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Specific files under review"
        },
        "commit": {
          "type": "string",
          "description": "Commit SHA (for commit targets)"
        },
        "baseRevision": {
          "type": "string",
          "minLength": 7,
          "description": "Immutable base commit resolved when the session starts"
        },
        "headRevision": {
          "type": "string",
          "minLength": 7,
          "description": "Immutable head commit resolved when the session starts"
        },
        "treeDigest": {
          "type": "string",
          "minLength": 1,
          "description": "Digest of the exact staged/worktree/commit content under review"
        },
        "spec": {
          "type": "string",
          "description": "Path or item id of the governing specification. When set, that spec is the review contract."
        },
        "specDigest": {
          "type": "string",
          "minLength": 1,
          "description": "Digest of the governing specification content"
        },
        "diffStats": {
          "type": "object",
          "properties": {
            "filesChanged": { "type": "integer" },
            "insertions": { "type": "integer" },
            "deletions": { "type": "integer" }
          }
        }
      }
    },

    "finding": {
      "type": "object",
      "description": "A single review finding",
      "required": [
        "id",
        "fingerprint",
        "severity",
        "category",
        "description",
        "contractDisposition",
        "source",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^C-\\d{3}$",
          "description": "Finding ID within session (C-001, C-002, ...)"
        },
        "fingerprint": {
          "type": "string",
          "minLength": 1,
          "description": "Stable digest of target, contract disposition, location, and normalised issue"
        },
        "severity": {
          "type": "string",
          "enum": ["critical", "major", "minor", "nit"],
          "description": "Finding severity"
        },
        "category": {
          "type": "string",
          "enum": [
            "security",
            "correctness",
            "edge-case",
            "performance",
            "architecture",
            "style",
            "test-coverage",
            "documentation"
          ],
          "description": "Finding category"
        },
        "description": {
          "type": "string",
          "description": "Clear description of the issue"
        },
        "file": {
          "type": "string",
          "description": "File path (relative to repo root)"
        },
        "line": {
          "type": "integer",
          "minimum": 1,
          "description": "Line number"
        },
        "suggestion": {
          "type": "string",
          "description": "Suggested fix or improvement"
        },
        "contractDisposition": {
          "type": "string",
          "enum": ["in_contract", "later_item", "out_of_scope", "no_contract"],
          "description": "How the finding sits against the governing spec. critical/major require in_contract when a spec is present."
        },
        "contractRef": {
          "type": "string",
          "description": "Spec path or later item id that owns this finding"
        },
        "source": {
          "type": "string",
          "description": "Reviewer agent that produced this finding"
        },
        "sources": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true,
          "description": "All reviewers that independently corroborated this canonical finding"
        },
        "status": {
          "type": "string",
          "enum": ["open", "fixed", "deferred", "waived", "dismissed"],
          "description": "Current resolution state"
        },
        "resolution": {
          "type": "string",
          "description": "How the finding was resolved (commit ref, justification, etc.)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "resolvedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },

    "evidence": {
      "type": "object",
      "description": "Validation evidence attached to a session",
      "required": ["id", "type", "description"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^E-\\d{3}$",
          "description": "Evidence ID (E-001, E-002, ...)"
        },
        "type": {
          "type": "string",
          "enum": ["test", "lint", "security-scan", "build", "manual", "command"],
          "description": "Type of evidence"
        },
        "description": {
          "type": "string",
          "description": "What was validated"
        },
        "command": {
          "type": "string",
          "description": "Command that produced this evidence"
        },
        "result": {
          "type": "string",
          "enum": ["pass", "fail", "partial", "skipped"],
          "description": "Evidence outcome"
        },
        "output": {
          "type": "string",
          "description": "Abbreviated output or reference"
        },
        "findingIds": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Findings this evidence validates"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },

    "waiver": {
      "type": "object",
      "description": "Accepted-risk waiver for a finding",
      "required": ["findingId", "reason", "acceptedBy"],
      "properties": {
        "findingId": {
          "type": "string",
          "description": "ID of the waived finding"
        },
        "reason": {
          "type": "string",
          "description": "Justification for accepting the risk"
        },
        "acceptedBy": {
          "type": "string",
          "description": "Who accepted (user or agent name)"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "description": "Optional expiration for time-bound waivers"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },

    "sessionEvent": {
      "type": "object",
      "description": "A timestamped event in the session lifecycle",
      "required": ["type", "timestamp"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "session_created",
            "session_resumed",
            "session_paused",
            "session_abandoned",
            "session_closed",
            "reviewer_started",
            "reviewer_completed",
            "finding_added",
            "finding_corroborated",
            "finding_resolved",
            "evidence_added",
            "waiver_added",
            "escalated",
            "judge_recorded",
            "converged",
            "published"
          ],
          "description": "Event type"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "detail": {
          "type": "string",
          "description": "Human-readable detail"
        },
        "data": {
          "type": "object",
          "description": "Structured event data"
        }
      }
    },

    "planningSession": {
      "type": "object",
      "description": "A Planning Council session — multi-persona interrogation, negotiation, and synthesis for architecture/spec/APS planning",
      "required": ["id", "phase", "status", "problem", "createdAt"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^plan-[a-f0-9]{8}$",
          "description": "Unique session identifier (plan-{8 hex chars})"
        },
        "phase": {
          "type": "string",
          "enum": ["interrogation", "negotiation", "synthesis", "review", "converged"],
          "description": "Current planning phase"
        },
        "status": {
          "type": "string",
          "enum": ["active", "paused", "converged", "abandoned"],
          "description": "Session lifecycle state"
        },
        "problem": {
          "type": "string",
          "description": "The problem statement or feature description being planned"
        },
        "pack": {
          "type": "string",
          "enum": ["standard", "extended"],
          "description": "Persona pack (standard: 3 personas, extended: 5 personas)"
        },
        "personas": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Agent names participating in this planning council"
        },
        "interrogation": {
          "type": "object",
          "description": "Phase 1 data: questions from personas and user answers",
          "properties": {
            "questions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "category", "question", "source"],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^Q-\\d{3}$",
                    "description": "Question ID (Q-001, Q-002, ...)"
                  },
                  "category": {
                    "type": "string",
                    "enum": ["requirements", "constraints", "scope", "risk", "integration"],
                    "description": "Question category"
                  },
                  "question": { "type": "string" },
                  "why": {
                    "type": "string",
                    "description": "Why this question matters for the design"
                  },
                  "default_assumption": {
                    "type": "string",
                    "description": "What to assume if the user skips this question"
                  },
                  "source": {
                    "type": "string",
                    "description": "Persona that asked this question"
                  }
                }
              }
            },
            "answers": {
              "type": "object",
              "description": "Map of question ID to user answer (or 'skip' or 'negotiate')",
              "additionalProperties": { "type": "string" }
            }
          }
        },
        "negotiations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["topic", "participants", "outcome"],
            "properties": {
              "topic": {
                "type": "string",
                "description": "Decision topic being negotiated"
              },
              "participants": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Agent names in this negotiation"
              },
              "outcome": {
                "type": "string",
                "enum": ["consensus", "deadlock"],
                "description": "Negotiation result"
              },
              "result": {
                "type": "string",
                "description": "Consensus statement or deadlock summary"
              },
              "rounds": {
                "type": "integer",
                "minimum": 1,
                "description": "Number of negotiation rounds"
              },
              "history": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "agent": { "type": "string" },
                    "position": { "type": "string" },
                    "signal": {
                      "type": "string",
                      "enum": ["CONSENSUS", "COUNTER", "QUESTION"]
                    }
                  }
                },
                "description": "Round-by-round negotiation history"
              }
            }
          },
          "description": "Phase 2 data: pairwise negotiations on decision topics"
        },
        "objections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": { "type": "string" },
              "target": {
                "type": "string",
                "description": "Which deliverable this objection targets"
              },
              "description": { "type": "string" },
              "severity": {
                "type": "string",
                "enum": ["critical", "major", "minor"]
              },
              "status": {
                "type": "string",
                "enum": ["open", "resolved", "dismissed"]
              }
            }
          },
          "description": "Phase 4 data: review objections to synthesized deliverables"
        },
        "deliverables": {
          "type": "object",
          "description": "File paths (relative to repo root) of generated artefacts",
          "properties": {
            "architecture": {
              "type": "string",
              "description": "Path to architecture decision document"
            },
            "modules": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Paths to generated APS module files"
            },
            "indexUpdated": {
              "type": "boolean",
              "description": "Whether plans/index.aps.md was updated"
            }
          }
        },
        "events": {
          "type": "array",
          "items": { "$ref": "#/definitions/planningEvent" },
          "description": "Chronological event log"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "convergedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },

    "planningEvent": {
      "type": "object",
      "description": "A timestamped event in the planning council lifecycle",
      "required": ["type", "timestamp"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "session_created",
            "session_resumed",
            "session_paused",
            "session_abandoned",
            "interrogation_started",
            "interrogation_completed",
            "negotiation_started",
            "negotiation_completed",
            "negotiation_consensus",
            "negotiation_deadlock",
            "synthesis_started",
            "synthesis_completed",
            "review_started",
            "review_completed",
            "objection_raised",
            "objection_resolved",
            "converged"
          ],
          "description": "Event type"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "detail": {
          "type": "string",
          "description": "Human-readable detail"
        },
        "data": {
          "type": "object",
          "description": "Structured event data"
        }
      }
    },

    "judgeResult": {
      "type": "object",
      "description": "Judge outcome for one immutable candidate. `decision` is the ADR-0025 routing vocabulary; `gate` is the legacy wire value kept for publication and merge consumers.",
      "required": ["decision", "gate", "candidateHead", "decidedAt"],
      "properties": {
        "decision": {
          "type": "string",
          "enum": ["PASS", "REPAIR", "REWORK", "REPLAN", "BLOCK", "DEBATE_REQUIRED"],
          "description": "Routing decision consumed by the agentic loop"
        },
        "gate": {
          "type": "string",
          "enum": ["PASS", "WARN", "BLOCK"],
          "description": "Legacy gate value derived from decision"
        },
        "rationale": {
          "type": "string",
          "description": "Short reason for the decision"
        },
        "candidateHead": {
          "type": "string",
          "minLength": 1,
          "description": "Revision the decision is bound to; a different head stales it"
        },
        "repairPassesUsed": {
          "type": "integer",
          "minimum": 0,
          "description": "Bounded repair passes consumed so far"
        },
        "decidedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },

    "publicationSummary": {
      "type": "object",
      "description": "Publication-ready review summary for PR/commit surfaces",
      "required": ["sessionId", "mode", "reviewerPack"],
      "properties": {
        "sessionId": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "enum": ["streaming", "batch", "design", "assurance"]
        },
        "reviewerPack": {
          "type": "string",
          "enum": ["quick", "standard", "full", "full:codex", "risk-selected"]
        },
        "decision": {
          "type": "string",
          "enum": ["PASS", "REPAIR", "REWORK", "REPLAN", "BLOCK", "DEBATE_REQUIRED"],
          "description": "Judge decision when one was recorded"
        },
        "gate": {
          "type": "string",
          "enum": ["PASS", "WARN", "BLOCK"],
          "description": "Legacy gate value derived from decision"
        },
        "reviewers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "target": {
          "type": "string",
          "description": "Human-readable target description"
        },
        "findingCounts": {
          "type": "object",
          "properties": {
            "total": { "type": "integer" },
            "fixed": { "type": "integer" },
            "deferred": { "type": "integer" },
            "waived": { "type": "integer" },
            "dismissed": { "type": "integer" },
            "open": { "type": "integer" }
          }
        },
        "severityCounts": {
          "type": "object",
          "properties": {
            "critical": { "type": "integer" },
            "major": { "type": "integer" },
            "minor": { "type": "integer" },
            "nit": { "type": "integer" }
          }
        },
        "notableWaivers": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Human-readable waiver summaries"
        },
        "evidenceSummary": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Human-readable evidence summaries"
        },
        "verdict": {
          "type": "string",
          "enum": ["clean", "clean-with-waivers", "open-findings", "not-converged"],
          "description": "Overall review verdict"
        },
        "markdownBody": {
          "type": "string",
          "description": "Pre-rendered markdown for PR body injection"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
