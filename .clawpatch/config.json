{
  "schemaVersion": 1,
  "stateDir": ".clawpatch",
  "include": ["**/*"],
  "exclude": [
    "node_modules/**",
    "dist/**",
    "build/**",
    "target/**",
    ".build/**",
    ".docusaurus/**",
    ".git/**",
    ".next/**",
    ".nx/**",
    ".clawpatch/**",
    ".worktrees/**",
    ".claude/worktrees/**",
    "coverage/**",
    "out-tsc/**",
    "tmp/**",
    ".tmp/**",
    "logs/**"
  ],
  "provider": {
    "name": "codex",
    "model": null
  },
  "commands": {
    "typecheck": "pnpm typecheck",
    "lint": "pnpm lint:check",
    "format": "pnpm format:check",
    "test": "pnpm test"
  },
  "review": {
    "maxContextFiles": 24,
    "maxOwnedFiles": 12,
    "maxFindingsPerFeature": 10,
    "minConfidenceToFix": "medium"
  },
  "git": {
    "requireCleanWorktreeForFix": true,
    "commit": false,
    "openPr": false
  }
}
