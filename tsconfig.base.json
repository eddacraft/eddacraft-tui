{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2025"],
    "types": ["node"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2025",
    "customConditions": ["@eddacraft/anvil-source"],
    "paths": {
      "@eddacraft/anvil-adapters": ["./packages/adapters/dist/index.d.ts"],
      "@eddacraft/anvil-aps": ["./packages/aps/dist/index.d.ts"],
      "@eddacraft/anvil-docs-meta": ["./packages/docs-meta/dist/index.d.ts"],
      "@eddacraft/anvil-driver-client": ["./packages/anvil-driver-client/dist/index.d.ts"],
      "@eddacraft/anvil-core": ["./packages/anvil/core/dist/index.d.ts"],
      "@eddacraft/anvil-core/*": ["./packages/anvil/core/dist/*/index.d.ts"],
      "@eddacraft/anvil-contracts": ["./packages/anvil/contracts/dist/index.d.ts"],
      "@eddacraft/anvil-flags-catalogue": ["./packages/anvil/flags-catalogue/dist/index.d.ts"],
      "@eddacraft/anvil-observability": ["./packages/anvil/observability/dist/index.d.ts"],
      "@eddacraft/anvil-ports": ["./packages/anvil/ports/dist/index.d.ts"],
      "@eddacraft/anvil-runtime": ["./packages/anvil/runtime/dist/index.d.ts"],
      "@eddacraft/anvil-runtime/*": ["./packages/anvil/runtime/dist/*/index.d.ts"],
      "@eddacraft/anvil-policy": ["./packages/anvil/policy/dist/index.d.ts"],
      "@eddacraft/anvil-edda-stack": ["./packages/edda-stack/dist/index.d.ts"],
      "@eddacraft/anvil-api": ["./apps/anvil-api/dist/index.d.ts"],
      "@eddacraft/transactional": ["./packages/transactional/dist/emails/index.d.ts"],
      "@eddacraft/anvil-eslint-config": ["./packages/tooling/eslint-config/index.mjs"],
      "@eddacraft/anvil-tsconfig/*": ["./packages/tooling/tsconfig/*"],
      "@eddacraft/anvil-shared/*": ["./packages/shared/*/dist/index.d.ts"],
      "@eddacraft/render": ["./packages/libs/render/dist/index.d.ts"]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    ".nx",
    "tmp",
    "coverage",
    "playwright-report",
    "test-results",
    "archive"
  ]
}
