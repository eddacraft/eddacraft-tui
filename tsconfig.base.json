{
  "compilerOptions": {
    "baseUrl": ".",
    "composite": true,
    "declarationMap": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@anvil/source"],
    "paths": {
      "@anvil/adapters": ["packages/adapters/dist/index.d.ts"],
      "@anvil/aps": ["packages/aps/dist/index.d.ts"],
      "@anvil/core": ["core/dist/index.d.ts"],
      "@anvil/contracts": ["packages/anvil/contracts/dist/index.d.ts"],
      "@anvil/ports": ["packages/anvil/ports/dist/index.d.ts"],
      "@anvil/runtime": ["packages/anvil/runtime/dist/index.d.ts"],
      "@anvil/policy": ["packages/anvil/policy/dist/index.d.ts"],
      "@anvil/edda-stack": ["packages/edda-stack/dist/index.d.ts"],
      "@anvil/eslint-config": ["packages/tooling/eslint-config/index.mjs"],
      "@anvil/tsconfig/*": ["packages/tooling/tsconfig/*"],
      "@anvil/platform/*": ["packages/platform/*/dist/index.d.ts"],
      "@anvil/shared/*": ["packages/shared/*/dist/index.d.ts"]
    }
  },
  "exclude": ["node_modules", "dist", ".nx", "tmp", "coverage", "playwright-report", "test-results"]
}
