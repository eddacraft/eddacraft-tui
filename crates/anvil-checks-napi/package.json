{
  "name": "@eddacraft/anvil-checks-native",
  "version": "0.6.0-beta",
  "description": "Native Anvil scanner via Node-API binding to the Rust engine",
  "private": true,
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "napi": {
    "binaryName": "anvil-checks-native",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "napi build --platform --profile release-napi --js index.js --dts index.d.ts --manifest-path Cargo.toml",
    "build:debug": "napi build --platform --js index.js --dts index.d.ts --manifest-path Cargo.toml",
    "pretest": "node scripts/check-binding-fresh.mjs",
    "test": "node --test __tests__/*.test.mjs",
    "prepublishOnly": "napi pre-publish --tag-style npm --no-gh-release --dry-run"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.7.0"
  }
}
