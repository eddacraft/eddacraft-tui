{
  "name": "@anvil/source",
  "version": "0.0.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.20.0"
  },
  "scripts": {
    "prepare": "husky",
    "build": "nx run-many -t build",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint . --fix && markdownlint --ignore-path .markdownlintignore . --fix",
    "lint:check": "eslint . && markdownlint --ignore-path .markdownlintignore .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "lint:md": "markdownlint --ignore-path .markdownlintignore .",
    "lint:md:fix": "markdownlint --ignore-path .markdownlintignore . --fix",
    "link:cli": "cd cli && pnpm build && npm link",
    "unlink:cli": "cd cli && npm unlink -g @anvil/cli"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@eslint/json": "^0.14.0",
    "@eslint/markdown": "^7.5.1",
    "@nx/js": "22.0.4",
    "@playwright/test": "^1.56.1",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.13.21",
    "@swc/helpers": "~0.5.17",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "@vitest/coverage-v8": "^4.0.10",
    "@vitest/ui": "^4.0.10",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.5.0",
    "happy-dom": "^20.0.10",
    "husky": "^9.1.7",
    "jsonc-eslint-parser": "^2.4.1",
    "lint-staged": "^16.2.6",
    "nx": "22.0.4",
    "prettier": "^3.6.2",
    "prettier-eslint": "^16.4.2",
    "ts-node": "10.9.2",
    "tslib": "^2.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.47.0",
    "verdaccio": "^6.2.1",
    "vite": "^7.2.2",
    "vitest": "^4.0.10"
  },
  "dependencies": {
    "@github/copilot": "^0.0.360",
    "@nx/eslint": "^22.0.4",
    "@nx/vite": "^22.0.4",
    "github-cli": "^0.0.5",
    "markdownlint-cli": "^0.45.0"
  },
  "packageManager": "pnpm@10.22.0+sha512.bf049efe995b28f527fd2b41ae0474ce29186f7edcb3bf545087bd61fbbebb2bf75362d1307fda09c2d288e1e499787ac12d4fcb617a974718a6051f2eee741c",
  "nx": {
    "includedScripts": []
  }
}
