{
  "name": "@anvil/source",
  "version": "0.0.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.20.0"
  },
  "scripts": {
    "prepare": "husky",
    "build": "nx run-many -t build",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prelint": "pnpm -F eslint-plugin-anvil build",
    "lint": "eslint . --fix && markdownlint --ignore-path .markdownlintignore . --fix",
    "prelint:check": "pnpm -F eslint-plugin-anvil build",
    "lint:check": "eslint . && markdownlint --ignore-path .markdownlintignore .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "lint:md": "markdownlint --ignore-path .markdownlintignore .",
    "lint:md:fix": "markdownlint --ignore-path .markdownlintignore . --fix",
    "link:cli": "cd cli && pnpm build && npm link",
    "unlink:cli": "cd cli && npm unlink -g @anvil/cli"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint-plugin-anvil": "workspace:*",
    "@eslint/json": "^0.14.0",
    "@eslint/markdown": "^7.5.1",
    "@nx/js": "22.3.3",
    "@playwright/test": "^1.57.0",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.8",
    "@swc/helpers": "~0.5.18",
    "@types/node": "^25.0.7",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "@vitest/coverage-v8": "^4.0.17",
    "@vitest/ui": "^4.0.17",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.0.0",
    "happy-dom": "^20.1.0",
    "husky": "^9.1.7",
    "jsonc-eslint-parser": "^2.4.2",
    "lint-staged": "^16.2.7",
    "nx": "22.3.3",
    "prettier": "^3.7.4",
    "prettier-eslint": "^16.4.2",
    "ts-node": "10.9.2",
    "tslib": "^2.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.53.0",
    "verdaccio": "^6.2.4",
    "vite": "^7.3.1",
    "vitest": "^4.0.17"
  },
  "dependencies": {
    "@github/copilot": "^0.0.377",
    "@nx/eslint": "^22.3.3",
    "@nx/vite": "^22.3.3",
    "markdownlint-cli": "^0.47.0"
  },
  "overrides": {
    "node.extend": "1.1.7",
    "glob": "13.0.0",
    "braces": "3.0.3",
    "micromatch": "4.0.8",
    "qs": "6.14.1"
  },
  "pnpm": {
    "overrides": {
      "node.extend": "1.1.7",
      "glob": "13.0.0",
      "braces": "3.0.3",
      "micromatch": "4.0.8",
      "qs": "6.14.1"
    },
    "onlyBuiltDependencies": [
      "node-pty"
    ]
  },
  "packageManager": "pnpm@10.26.0+sha512.3b3f6c725ebe712506c0ab1ad4133cf86b1f4b687effce62a9b38b4d72e3954242e643190fc51fa1642949c735f403debd44f5cb0edd657abe63a8b6a7e1e402",
  "nx": {
    "includedScripts": []
  }
}
