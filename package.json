{
  "name": "@eddacraft/anvil-source",
  "version": "0.1.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.20.0"
  },
  "scripts": {
    "prepare": "husky",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test --exclude=@eddacraft/anvil-e2e",
    "test:coverage": "nx run-many -t test --exclude=@eddacraft/anvil-e2e -- --coverage",
    "test:e2e": "playwright test",
    "test:e2e:harness": "pnpm --filter @eddacraft/anvil-e2e test",
    "test:e2e:smoke": "pnpm --filter @eddacraft/anvil-e2e test:smoke",
    "test:e2e:cli": "pnpm --filter @eddacraft/anvil-e2e test:cli",
    "test:e2e:api": "pnpm --filter @eddacraft/anvil-e2e test:api",
    "test:e2e:core": "pnpm --filter @eddacraft/anvil-e2e test:core",
    "lint": "nx run-many -t lint && markdownlint --ignore-path .markdownlintignore . --fix",
    "lint:check": "nx run-many -t lint && markdownlint --ignore-path .markdownlintignore .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "nx run-many -t typecheck --exclude=anvil-vscode",
    "lint:md": "markdownlint --ignore-path .markdownlintignore .",
    "lint:md:fix": "markdownlint --ignore-path .markdownlintignore . --fix",
    "link:cli": "cd apps/anvil-cli && pnpm build && npm link",
    "unlink:cli": "cd apps/anvil-cli && npm unlink -g @eddacraft/anvil-cli",
    "codemod:imports": "tsx tools/codemods/src/cli.ts imports",
    "codemod:imports:dry": "tsx tools/codemods/src/cli.ts imports --dry-run",
    "generate:package": "nx g @eddacraft/anvil-generators:package",
    "generate:anvil-package": "nx g @eddacraft/anvil-generators:anvil-package",
    "agent:run": "bash tools/local-agent-run.sh"
  },
  "private": true,
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@eslint/js": "^9.39.2",
    "@eslint/json": "^1.0.1",
    "@eslint/markdown": "^7.5.1",
    "@nx/azure-cache": "^5.0.0",
    "@nx/eslint-plugin": "22.5.1",
    "@nx/js": "22.5.1",
    "@playwright/test": "^1.58.2",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.11",
    "@swc/helpers": "~0.5.18",
    "@types/node": "^25.2.3",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-anvil": "workspace:*",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-unicorn": "^63.0.0",
    "globals": "^17.3.0",
    "happy-dom": "^20.6.1",
    "husky": "^9.1.7",
    "jsonc-eslint-parser": "^2.4.2",
    "lint-staged": "^16.2.7",
    "nx": "22.5.1",
    "prettier": "^3.8.1",
    "prettier-eslint": "^16.4.2",
    "ts-node": "10.9.2",
    "tslib": "^2.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.0",
    "verdaccio": "^6.2.5",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@github/copilot": "^0.0.410",
    "@nx/eslint": "^22.5.1",
    "@nx/vite": "^22.5.1",
    "markdownlint-cli": "^0.47.0"
  },
  "overrides": {
    "node.extend": "1.1.7",
    "glob": "13.0.0",
    "braces": "3.0.3",
    "micromatch": "4.0.8",
    "qs": "^6.14.2",
    "tar": "^7.5.4",
    "lodash": "^4.17.23",
    "undici": "^7.18.2",
    "diff": "^4.0.4",
    "markdown-it": "^14.1.1",
    "@isaacs/brace-expansion": "^5.0.1",
    "cross-spawn": "^7.0.6",
    "@eddacraft/kindling-core": "0.1.2",
    "minimatch": ">=10.2.3",
    "rollup": ">=4.59.0"
  },
  "pnpm": {
    "overrides": {
      "node.extend": "1.1.7",
      "glob": "13.0.0",
      "braces": "3.0.3",
      "micromatch": "4.0.8",
      "qs": "^6.14.2",
      "tar": "^7.5.4",
      "lodash": "^4.17.23",
      "undici": "^7.18.2",
      "diff": "^4.0.4",
      "markdown-it": "^14.1.1",
      "@isaacs/brace-expansion": "^5.0.1",
      "cross-spawn": "^7.0.6",
      "@eddacraft/kindling-core": "0.1.2",
      "minimatch@<3.1.4": "3.1.5",
      "minimatch@>=5.0.0 <5.1.8": "5.1.8",
      "minimatch@>=7.0.0 <7.4.8": "7.4.8",
      "minimatch@>=10.0.0 <10.2.3": "10.2.3",
      "rollup@>=4.0.0 <4.59.0": ">=4.59.0",
      "ajv@<6.14.0": "6.14.0",
      "ajv@>=7.0.0-alpha.0 <8.18.0": ">=8.18.0",
      "eslint>ajv": "6.14.0",
      "@eslint/eslintrc>ajv": "6.14.0",
      "serialize-javascript@<=7.0.2": ">=7.0.3"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "nx",
      "better-sqlite3"
    ],
    "ignoredBuiltDependencies": [
      "@devm33/node-pty",
      "@swc/core",
      "@vscode/vsce-sign",
      "core-js",
      "core-js-pure",
      "keytar",
      "keytar-forked-forked",
      "unrs-resolver"
    ]
  },
  "packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017",
  "nx": {
    "includedScripts": []
  }
}
