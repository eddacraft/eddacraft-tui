{
  "name": "@eddacraft/anvil-source",
  "version": "0.0.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.20.0"
  },
  "scripts": {
    "prepare": "husky",
    "build": "nx run-many -t build",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "prelint": "pnpm -F eslint-plugin-anvil build",
    "lint": "eslint . --fix && markdownlint --ignore-path .markdownlintignore . --fix",
    "prelint:check": "pnpm -F eslint-plugin-anvil build",
    "lint:check": "eslint . && markdownlint --ignore-path .markdownlintignore .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "lint:md": "markdownlint --ignore-path .markdownlintignore .",
    "lint:md:fix": "markdownlint --ignore-path .markdownlintignore . --fix",
    "link:cli": "cd apps/anvil-cli && pnpm build && npm link",
    "unlink:cli": "cd apps/anvil-cli && npm unlink -g @eddacraft/anvil-cli",
    "codemod:imports": "tsx tools/codemods/src/cli.ts imports",
    "codemod:imports:dry": "tsx tools/codemods/src/cli.ts imports --dry-run",
    "generate:package": "nx g @eddacraft/anvil-generators:package",
    "generate:anvil-package": "nx g @eddacraft/anvil-generators:anvil-package"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@eslint/json": "^0.14.0",
    "@eslint/markdown": "^7.5.1",
    "@nx/eslint-plugin": "22.4.1",
    "@nx/js": "22.4.1",
    "@playwright/test": "^1.57.0",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.10",
    "@swc/helpers": "~0.5.18",
    "@types/node": "^25.0.10",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-anvil": "workspace:*",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.1.0",
    "happy-dom": "^20.3.7",
    "husky": "^9.1.7",
    "jsonc-eslint-parser": "^2.4.2",
    "lint-staged": "^16.2.7",
    "nx": "22.4.1",
    "prettier": "^3.8.1",
    "prettier-eslint": "^16.4.2",
    "ts-node": "10.9.2",
    "tslib": "^2.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.53.1",
    "verdaccio": "^6.2.4",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@github/copilot": "^0.0.385",
    "@nx/eslint": "^22.3.3",
    "@nx/vite": "^22.3.3",
    "markdownlint-cli": "^0.47.0"
  },
  "overrides": {
    "node.extend": "1.1.7",
    "glob": "13.0.0",
    "braces": "3.0.3",
    "micromatch": "4.0.8",
    "qs": "6.14.1"
  },
  "pnpm": {
    "overrides": {
      "node.extend": "1.1.7",
      "glob": "13.0.0",
      "braces": "3.0.3",
      "micromatch": "4.0.8",
      "qs": "6.14.1",
      "tar": ">=7.5.4",
      "lodash": ">=4.17.23",
      "undici": ">=7.18.2",
      "diff": ">=4.0.4"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "nx"
    ],
    "ignoredBuiltDependencies": [
      "@devm33/node-pty",
      "@swc/core",
      "@vscode/vsce-sign",
      "core-js",
      "core-js-pure",
      "keytar",
      "keytar-forked-forked",
      "unrs-resolver"
    ]
  },
  "packageManager": "pnpm@10.26.0+sha512.3b3f6c725ebe712506c0ab1ad4133cf86b1f4b687effce62a9b38b4d72e3954242e643190fc51fa1642949c735f403debd44f5cb0edd657abe63a8b6a7e1e402",
  "nx": {
    "includedScripts": []
  }
}
