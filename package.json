{
  "name": "@eddacraft/anvil-source",
  "version": "0.5.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10.20.0",
    "git": ">=2.54.0"
  },
  "huskyNote": "GHOOK-005 keeps Husky as the contributor bootstrap. `pnpm install` runs `prepare: husky`, installs Husky's hook wiring, and activates the tracked `.husky/pre-commit` hook. Contributors who want to test Git 2.54 native config-mode hooks locally can run `anvil hooks install --config` after `pnpm install`; see docs/guides/git-hook-compatibility.md for the migration decision and revisit conditions.",
  "scripts": {
    "prepare": "husky",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "build": "nx run-many -t build --exclude=@eddacraft/nx-rust",
    "test": "nx run-many -t test --exclude=@eddacraft/anvil-e2e --exclude=@eddacraft/nx-rust --exclude=@eddacraft/anvil-checks-native",
    "test:coverage": "pnpm test:coverage:ts && pnpm test:coverage:rust",
    "test:coverage:ts": "nx run-many -t test --exclude=@eddacraft/anvil-e2e --exclude=@eddacraft/nx-rust --exclude=@eddacraft/anvil-checks-native -- --coverage",
    "test:coverage:rust": "cargo llvm-cov nextest --workspace --html && cargo test --doc --workspace",
    "test:e2e": "playwright test",
    "test:e2e:harness": "pnpm --filter @eddacraft/anvil-e2e test",
    "test:e2e:smoke": "pnpm --filter @eddacraft/anvil-e2e test:smoke",
    "test:e2e:cli": "pnpm --filter @eddacraft/anvil-e2e test:cli",
    "test:e2e:api": "pnpm --filter @eddacraft/anvil-e2e test:api",
    "test:e2e:core": "pnpm --filter @eddacraft/anvil-e2e test:core",
    "test:scanner-parity": "pnpm --filter @eddacraft/anvil-core exec vitest run src/antipattern/scanner-parity.test.ts && cargo test -p eddacraft-anvil-checks --test scanner_parity",
    "projects:rust": "nx show projects --withTarget=check --json | node -p \"JSON.parse(require('node:fs').readFileSync(0, 'utf8')).join(',')\"",
    "lint:rust": "RUST_PROJECTS=$(pnpm -s run projects:rust) && nx run-many -t clippy,fmt-check --projects=\"$RUST_PROJECTS\"",
    "lint": "oxlint . && nx run-many -t lint && pnpm run lint:rust && markdownlint --ignore-path .markdownlintignore . --fix",
    "lint:check": "oxlint . && nx run-many -t lint && pnpm run lint:rust && markdownlint --ignore-path .markdownlintignore .",
    "lint:ox": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck:rust": "RUST_PROJECTS=$(pnpm -s run projects:rust) && nx run-many -t check --projects=\"$RUST_PROJECTS\"",
    "licenses:verify": "tools/starters/acknowledgements/generate-acknowledgements.sh --check",
    "typecheck": "nx run-many -t typecheck --exclude=anvil-vscode --exclude=@eddacraft/nx-rust && pnpm run typecheck:rust",
    "lint:md": "markdownlint --ignore-path .markdownlintignore .",
    "lint:md:fix": "markdownlint --ignore-path .markdownlintignore . --fix",
    "codemod:imports": "tsx tools/codemods/src/cli.ts imports",
    "codemod:imports:dry": "tsx tools/codemods/src/cli.ts imports --dry-run",
    "generate:package": "nx g @eddacraft/anvil-generators:package",
    "generate:anvil-package": "nx g @eddacraft/anvil-generators:anvil-package",
    "generate:command": "nx g @eddacraft/anvil-generators:command",
    "agent:run": "bash tools/local-agent-run.sh",
    "admin": "tsx apps/admin-cli/src/index.ts"
  },
  "private": true,
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.31.0",
    "@eddacraft/nx-rust": "workspace:*",
