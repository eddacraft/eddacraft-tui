{
  "name": "@eddacraft/anvil-source",
  "version": "0.8.1-beta",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.20.0",
    "git": ">=2.54.0"
  },
  "huskyNote": "GHOOK-005 keeps Husky as the contributor bootstrap. `pnpm install` runs `prepare: husky`, installs Husky's hook wiring, and activates the tracked `.husky/pre-commit` hook. Contributors who want to test Git 2.54 native config-mode hooks locally can run `anvil hooks install --config` after `pnpm install`; see docs/guides/git-hook-compatibility.md for the migration decision and revisit conditions.",
  "scripts": {
    "prepare": "husky",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "build": "nx run-many -t build",
    "test": "pnpm test:js && pnpm test:rust",
    "test:js": "nx run-many -t test --projects=tag:npm:public,tag:npm:private --exclude=@eddacraft/anvil-source --exclude=@eddacraft/anvil-e2e --exclude=@eddacraft/anvil-checks-native",
    "test:rust": "cargo test --workspace",
    "test:coverage": "pnpm test:coverage:ts && pnpm test:coverage:rust",
    "test:coverage:ts": "nx run-many -t test --projects=tag:npm:public,tag:npm:private --exclude=@eddacraft/anvil-source --exclude=@eddacraft/anvil-e2e --exclude=@eddacraft/anvil-checks-native -- --coverage",
    "test:coverage:rust": "cargo llvm-cov nextest --workspace --html && cargo llvm-cov report --summary-only && cargo test --doc --workspace",
    "test:e2e": "playwright test",
    "test:e2e:harness": "pnpm --filter @eddacraft/anvil-e2e test",
    "test:e2e:smoke": "pnpm --filter @eddacraft/anvil-e2e test:smoke",
    "test:e2e:cli": "pnpm --filter @eddacraft/anvil-e2e test:cli",
    "test:e2e:api": "pnpm --filter @eddacraft/anvil-e2e test:api",
    "test:e2e:core": "pnpm --filter @eddacraft/anvil-e2e test:core",
    "bench": "bash scripts/bench/run.sh",
    "projects:rust": "nx show projects --withTarget=check --json | node -p \"JSON.parse(require('node:fs').readFileSync(0, 'utf8')).join(',')\"",
    "lint:rust": "RUST_PROJECTS=$(pnpm -s run projects:rust) && nx run-many -t clippy,fmt-check --projects=\"$RUST_PROJECTS\"",
    "lint": "oxlint . && nx run-many -t lint && pnpm run lint:rust && markdownlint --ignore-path .markdownlintignore .",
    "lint:check": "oxlint . && nx run-many -t lint && pnpm run lint:rust && markdownlint --ignore-path .markdownlintignore .",
    "lint:ox": "oxlint .",
    "format": "pnpm exec oxfmt --write .",
    "format:check": "pnpm exec oxfmt --check .",
    "typecheck:rust": "RUST_PROJECTS=$(pnpm -s run projects:rust) && nx run-many -t check --projects=\"$RUST_PROJECTS\"",
    "licenses:verify": "tools/starters/acknowledgements/generate-acknowledgements.sh --check",
    "typecheck": "nx run-many -t typecheck --exclude=anvil-vscode && pnpm run typecheck:rust",
    "lint:md": "markdownlint --ignore-path .markdownlintignore .",
    "lint:md:fix": "markdownlint --ignore-path .markdownlintignore . --fix",
    "codemod:imports": "tsx tools/codemods/src/cli.ts imports",
    "codemod:imports:dry": "tsx tools/codemods/src/cli.ts imports --dry-run",
    "ci:classify": "bash scripts/ci/classify-changes.sh",
    "test:ci-classify": "bash scripts/ci/classify-changes.test.sh",
    "test:release-readiness-workflow": "bash scripts/ci/release-readiness-workflow.test.sh",
    "test:ci-cost": "bash scripts/ci/cost-report.test.sh",
    "test:ci-fast-pr": "bash scripts/ci/fast-pr-validation.test.sh",
    "test:ci-integration": "bash scripts/ci/integration-validation.test.sh",
    "test:ci-matrix-targeting": "bash scripts/ci/matrix-targeting.test.sh",
    "test:ci-drift-integration": "bash scripts/ci/drift-check-integration.test.sh",
    "test:ci-workflow-contracts": "bash scripts/ci/workflow-contracts.test.sh",
    "test:ci-mirror-hardening": "bash scripts/ci/mirror-workflow-hardening.test.sh",
    "test:ci-security-targeting": "bash scripts/ci/security-targeting.test.sh",
    "test:ci-cutover-readiness": "bash scripts/ci/cutover-readiness.test.sh",
    "test:aps-active-lint": "bash scripts/aps/_test/active-lint.test.sh",
    "test:aps-drift": "bash scripts/aps/_test/drift-check.test.sh",
    "test:aps-index": "bash scripts/aps/_test/index-counts.test.sh",
    "test:aps-advance-released": "bash scripts/aps/_test/advance-released.test.sh",
    "test:bench-parity": "bash scripts/bench-vs-go-opa.test.sh",
    "aps:active-lint": "node scripts/aps/active-lint.mjs",
    "aps:drift": "node scripts/aps/drift-check.mjs",
    "aps:index": "node scripts/aps/index-counts.mjs",
    "aps:index:check": "node scripts/aps/index-counts.mjs --check",
    "test:adr-integrity": "bash scripts/docs/adr-integrity.test.sh",
    "adr:check": "bash scripts/docs/adr-integrity.sh",
    "release-plan:check": "node scripts/docs/check-release-plan.mjs",
    "predocs:check": "pnpm -s -F @eddacraft/anvil-docs-meta build",
    "predocs:index": "pnpm -s -F @eddacraft/anvil-docs-meta build",
    "docs:index": "node scripts/docs/docs-index.mjs",
    "predocs:index:check": "pnpm -s -F @eddacraft/anvil-docs-meta build",
    "docs:index:check": "node scripts/docs/docs-index.mjs --check",
    "docs:check": "node scripts/docs/docs-check.mjs",
    "predocs:check:update-baseline": "pnpm -s -F @eddacraft/anvil-docs-meta build",
    "docs:check:update-baseline": "node scripts/docs/docs-check.mjs --update-baseline",
    "pretest:docs-check": "pnpm -s -F @eddacraft/anvil-docs-meta build",
    "test:docs-check": "bash scripts/docs/docs-check.test.sh",
    "validate:staged": "bash scripts/validate/local.sh --staged",
    "validate:changed": "bash scripts/validate/local.sh --changed",
    "validate:full": "bash scripts/validate/local.sh --full",
    "test:validate-local": "bash scripts/validate/local.test.sh",
    "test:cache-evict": "bash scripts/cache/anvil-target-evict.test.sh",
    "ci:cost": "bash scripts/ci/cost-report.sh",
    "generate:package": "nx g @eddacraft/anvil-generators:package",
    "generate:anvil-package": "nx g @eddacraft/anvil-generators:anvil-package",
    "generate:command": "nx g @eddacraft/anvil-generators:command",
    "agent:run": "bash tools/local-agent-run.sh",
    "admin": "tsx apps/admin-cli/src/index.ts"
  },
