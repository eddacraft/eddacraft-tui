{
  "name": "@anvil/source",
  "version": "0.0.0",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.17.1"
  },
  "scripts": {
    "prepare": "husky",
    "build": "nx run-many -t build",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint . --fix && markdownlint --ignore-path .markdownlintignore . --fix",
    "lint:check": "eslint . && markdownlint --ignore-path .markdownlintignore .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "lint:md": "markdownlint --ignore-path .markdownlintignore .",
    "lint:md:fix": "markdownlint --ignore-path .markdownlintignore . --fix",
    "link:cli": "cd cli && pnpm build && npm link",
    "unlink:cli": "cd cli && npm unlink -g @anvil/cli"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@eslint/json": "^0.13.2",
    "@eslint/markdown": "^7.4.1",
    "@nx/js": "21.6.5",
    "@playwright/test": "^1.56.1",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.13.5",
    "@swc/helpers": "~0.5.17",
    "@types/node": "^24.9.1",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.4.0",
    "happy-dom": "^20.0.7",
    "husky": "^9.1.7",
    "jsonc-eslint-parser": "^2.4.1",
    "lint-staged": "^16.2.5",
    "nx": "21.6.5",
    "prettier": "^3.6.2",
    "prettier-eslint": "^16.4.2",
    "ts-node": "10.9.2",
    "tslib": "^2.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.2",
    "verdaccio": "^6.2.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@github/copilot": "^0.0.347",
    "@nx/eslint": "^21.6.5",
    "@nx/vite": "^21.6.5",
    "github-cli": "^0.0.5",
    "markdownlint-cli": "^0.45.0"
  },
  "packageManager": "pnpm@10.20.0+sha512.cf9998222162dd85864d0a8102e7892e7ba4ceadebbf5a31f9c2fce48dfce317a9c53b9f6464d1ef9042cba2e02ae02a9f7c143a2b438cd93c91840f0192b9dd",
  "nx": {
    "includedScripts": []
  }
}
