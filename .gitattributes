# Normalise all text files to use LF in the repo
* text=auto

# Force specific file types to always use LF
*.sh text eol=lf
*.ts text eol=lf
*.mts text eol=lf
*.cts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
# .mjs especially: shebang'd ESM scripts fail to import under a CRLF checkout
# ("SyntaxError: Invalid or unexpected token" — the loader's shebang handling
# breaks on "#!...\r"), which silently killed the infra admin-key suite on
# every Windows CI leg.
*.mjs text eol=lf
*.cjs text eol=lf
*.jsx text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf

# Force specific file types to always use CRLF (rare, e.g. Windows batch files)
*.bat text eol=crlf
*.cmd text eol=crlf

# Keep binaries untouched
*.png binary
*.jpg binary
*.zip binary
anvil/witness/active.ndjson merge=union -text
anvil/witness/manifest/chain.ndjson merge=union -text

# Append-only log: keep both sides' added entries instead of emitting conflict
# markers, so concurrent agents/worktrees never collide on the tail. Honoured by
# git merge, cherry-pick, and the default merge-backend rebase (Git >= 2.26);
# NOT by a forced legacy `git rebase --apply`. Stays text/eol=lf via the *.md
# rule above (no -text).
plans/reviews/continuous-improvement-log.md merge=union
