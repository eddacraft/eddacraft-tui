{
  "name": "@eddacraft/anvil-cli",
  "version": "0.2.1-beta",
  "description": "CLI for Anvil - deterministic development automation platform",
  "type": "module",
  "bin": {
    "anvil": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "build:types": "tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "anvil",
    "automation",
    "validation",
    "quality-gates",
    "ai-safety",
    "speckit",
    "planning"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/eddacraft/anvil-001.git",
    "directory": "apps/anvil-cli"
  },
  "bugs": {
    "url": "https://github.com/eddacraft/anvil-001/issues"
  },
  "homepage": "https://github.com/eddacraft/anvil-001#readme",
  "author": "eddacraft",
  "dependencies": {
    "@eddacraft/kindling-core": "0.1.2",
    "@eddacraft/kindling-provider-local": "0.1.2",
    "@eddacraft/kindling-store-sqlite": "0.1.2"
  },
  "devDependencies": {
    "@eddacraft/anvil-adapters": "workspace:*",
    "@eddacraft/anvil-aps": "workspace:*",
    "@eddacraft/anvil-core": "workspace:*",
    "@eddacraft/anvil-edda-stack": "workspace:*",
    "@eddacraft/anvil-kindling-integration": "workspace:*",
    "@eddacraft/anvil-runtime": "workspace:*",
    "@types/fs-extra": "^11.0.4",
    "@types/react": "^19.2.14",
    "@types/semver": "^7.7.1",
    "beautiful-mermaid": "^1.1.3",
    "chalk": "^5.6.2",
    "chokidar": "5.0.0",
    "commander": "^14.0.3",
    "esbuild": "^0.28.1",
    "fs-extra": "^11.3.4",
    "glob": "^13.0.0",
    "ink": "6.8.0",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "ink-testing-library": "^4.0.0",
    "inquirer": "13.3.2",
    "jose": "^6.2.2",
    "node-pty": "^1.1.0",
    "ora": "9.3.0",
    "react": "19.2.4",
    "semver": "^7.7.4",
    "tuistory": "^0.0.16",
