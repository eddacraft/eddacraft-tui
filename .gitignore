settings.local.json
logs/
memory.json
autonomous-state.json
.setup-meta

# Anvil runtime sidecar — operator state appended on every run
anvil/kindling/
anvil/witness/

# Temporary files
*.tmp
*.bak

# Local review artefacts
review/
# `plans/reviews/` mostly ignored — but release-council artefacts,
# post-merge review files, CI notes, and dated Clawpatch review notes
# (triage, rust follow-ups, batch scopes) are durable review evidence.
# Lint tooling already excludes the whole `plans/` tree via .markdownlintignore
# and .prettierignore, so nothing tracked here is in scope for format/lint.
plans/reviews/*
!plans/reviews/continuous-improvement-log.md
!plans/reviews/20*-clawpatch-*.md
!plans/reviews/post-merge/
!plans/reviews/post-merge/**
!plans/reviews/release-council/
!plans/reviews/release-council/**
# Architecture review councils + their inputs (durable design evidence).
!plans/reviews/20*-daemon-graph-architecture-review.md
!plans/reviews/20*-daemon-graph-council-verdict.md
# Source review backing the 2026-05-09 plan/build/release operating-model spec.
!plans/reviews/plan-build-release-operating-model.md
# Source review backing the 2026-05-09 CPU problem analysis and response.
!plans/reviews/WATCH-CPU-PROBLEM.md
!plans/reviews/ANVIL-DAEMON-DESIGN-RESPONSE.md
!plans/reviews/2026-06-01-daemon-graph-architecture-review.md
# GitHub Local Runners
.github/actions-runner

# DBCON operator scratch — snapshots and exported CSVs must never land in git
scripts/dbcon/snapshots/
scripts/dbcon/*.csv

# Local scratch — drafts, throwaway notes, intermediate artefacts
.scratch/

# APSCAN-007: canonical `anvil-plan-spec` CLI generates context packages
# under `.aps/context/<ID>.md` when `aps start <work-item>` runs. Treat as
# safe-to-regenerate cache output; the durable issues/questions surface is
# `plans/issues.md`.
.aps/
