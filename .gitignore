# The whole .anvil/ tree is local runtime state (ADR-073; CIB-053 untracked
# the last legacy files) — matches what `anvil init` seeds for consumers.
.anvil/

# Claude Code — ignore local state, keep declarative config and vendored hooks
# Committed: agents/*.md, skills/, rules/*.md, commands/, selected hooks
# Ignored: council scripts, agent-bus, settings, mcp, sessions, local hook extras
# Machine-only adapter notes (personal hooks/toggles); thin CLAUDE.md stays tracked
CLAUDE.local.md
.claude/hooks/*
!.claude/hooks/post-edit.sh
!.claude/hooks/tdd-guard.sh
!.claude/hooks/on-agent-stop.sh
!.claude/hooks/session-start.sh
!.claude/hooks/council-protected-paths
.claude/council/
.claude/agent-bus/
# The council and agent-messaging skills write session state at the REPO ROOT
# (`<project>/.council/`, `PROJECT_ROOT/.agent-bus/`), not under .claude/ —
# the two entries above only cover the .claude-scoped variants. Root state is
# per-session review/message data, never repository content.
/.council/
/.agent-bus/
.claude/settings.json
.claude/settings.local.json
.claude/mcp.json
.claude/prompts
.claude/worktrees/
.claude/.setup-meta
.claude/.gitignore
.claude/logs/
