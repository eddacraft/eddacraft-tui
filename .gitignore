# Claude Code — ignore local state, keep declarative config and vendored hooks
# Committed: agents/*.md, skills/, rules/*.md, commands/, selected hooks
# Ignored: council scripts, agent-bus, settings, mcp, sessions, local hook extras
.claude/hooks/*
!.claude/hooks/post-edit.sh
!.claude/hooks/tdd-guard.sh
!.claude/hooks/on-agent-stop.sh
!.claude/hooks/session-start.sh
.claude/council/
.claude/agent-bus/
.claude/settings.json
.claude/settings.local.json
.claude/mcp.json
.claude/prompts
.claude/worktrees/
.claude/.setup-meta
.claude/.gitignore
.claude/logs/
.claude/scheduled_tasks.lock
.claude/memory.json
.claude/autonomous-state.json
.claude/skills/*
!.claude/skills/release/
!.claude/skills/dev-workflow/
!.claude/skills/planning-workflow/
!.claude/skills/aps-planning/
!.claude/skills/test-driven-development/
!.claude/skills/addressing-pr-reviews/
!.claude/skills/dependabot/
!.claude/skills/dependabot/**
!.claude/skills/planning-council/
.claude/VERSION
