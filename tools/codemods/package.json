{
  "name": "@eddacraft/anvil-codemods",
  "version": "0.3.0-beta",
  "description": "Codemods for Anvil monorepo migration",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "anvil-codemod": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "codemod:imports": "tsx src/cli.ts imports",
    "codemod:imports:dry": "tsx src/cli.ts imports --dry-run"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "glob": "^13.0.0",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3"
  },
  "keywords": [
    "anvil",
    "codemod",
    "migration"
  ],
  "license": "PROPRIETARY"
}
