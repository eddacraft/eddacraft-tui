{
  "name": "@eddacraft/anvil-codemods",
  "version": "0.1.0",
  "description": "Codemods for Anvil monorepo migration",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "anvil-codemod": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "codemod:imports": "tsx src/cli.ts imports",
    "codemod:imports:dry": "tsx src/cli.ts imports --dry-run"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "glob": "13.0.1",
    "ts-morph": "^27.0.2"
  },
  "devDependencies": {
    "@types/node": "^25.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "anvil",
    "codemod",
    "migration"
  ],
  "license": "PROPRIETARY"
}
