{
  "name": "@eddacraft/nx-rust",
  "version": "0.1.0",
  "description": "Nx plugin that wraps Cargo — executors, generators, and project-graph integration for Rust workspaces inside Nx monorepos.",
  "keywords": [
    "nx",
    "nx-plugin",
    "rust",
    "cargo",
    "monorepo",
    "workspace"
  ],
  "homepage": "https://github.com/EddaCraft/nxrust",
  "repository": {
    "type": "git",
    "url": "https://github.com/EddaCraft/nxrust.git"
  },
  "license": "PROPRIETARY",
  "author": "EddaCraft",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.json",
    "dist/**/files/**",
    "executors.json",
    "generators.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "executors": "./executors.json",
  "generators": "./generators.json",
  "scripts": {
    "build": "tsc -p tsconfig.json && node ./tools/copy-assets.mjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ltd/j-toml": "^1.38.0"
  },
  "peerDependencies": {
    "@nx/devkit": ">=22.0.0"
  },
  "devDependencies": {
    "@nx/devkit": "^22.7.2",
    "@types/node": "^25.7.0",
    "nx": "^22.7.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
