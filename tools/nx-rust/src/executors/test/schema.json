{
  "$schema": "http://json-schema.org/schema",
  "version": 2,
  "outputCapture": "direct-nodejs",
  "title": "nxrust:test",
  "description": "Test a Rust crate with `cargo test`.",
  "type": "object",
  "properties": {
    "toolchain": { "type": "string", "default": "stable" },
    "target": { "type": "string" },
    "profile": { "type": "string" },
    "release": { "type": "boolean", "default": false },
    "target-dir": { "type": "string" },
    "features": {
      "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }]
    },
    "all-features": { "type": "boolean", "default": false },
    "no-default-features": { "type": "boolean", "default": false },
    "locked": { "type": "boolean", "default": false },
    "frozen": { "type": "boolean", "default": false },
    "offline": { "type": "boolean", "default": false },
    "package": { "type": "string" },
    "doc": { "type": "boolean", "default": false, "description": "Run only doctests." },
    "lib": { "type": "boolean", "default": false },
    "bin": {
      "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }]
    },
    "bins": { "type": "boolean", "default": false },
    "test": {
      "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }]
    },
    "tests": { "type": "boolean", "default": false },
    "all-targets": { "type": "boolean", "default": false },
    "no-run": { "type": "boolean", "default": false },
    "no-fail-fast": { "type": "boolean", "default": false },
    "args": {
      "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }],
      "description": "Arguments forwarded to the test binary after `--` (e.g. --nocapture, filter strings)."
    }
  },
  "required": []
}
