{
  "$schema": "http://json-schema.org/schema",
  "version": 2,
  "outputCapture": "direct-nodejs",
  "title": "@eddacraft/nx-rust:clippy",
  "description": "Lint a Rust crate with `cargo clippy`.",
  "type": "object",
  "properties": {
    "toolchain": { "type": "string", "default": "stable" },
    "target": { "type": "string" },
    "profile": { "type": "string" },
    "release": { "type": "boolean", "default": false },
    "target-dir": { "type": "string" },
    "features": {
      "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }]
    },
    "all-features": { "type": "boolean", "default": false },
    "no-default-features": { "type": "boolean", "default": false },
    "locked": { "type": "boolean", "default": false },
    "frozen": { "type": "boolean", "default": false },
    "offline": { "type": "boolean", "default": false },
    "package": { "type": "string" },
    "all-targets": { "type": "boolean", "default": false },
    "fix": {
      "type": "boolean",
      "default": false,
      "description": "Apply clippy suggestions automatically (implies --allow-dirty)."
    },
    "args": {
      "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }],
      "description": "Raw passthrough — use to supply clippy lint flags (e.g. ['-D', 'warnings'])."
    }
  },
  "required": []
}
