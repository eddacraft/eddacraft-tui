{
  "$schema": "http://json-schema.org/schema",
  "version": 2,
  "outputCapture": "direct-nodejs",
  "title": "@eddacraft/nx-rust:run",
  "description": "Run a Rust binary with `cargo run`.",
  "type": "object",
  "properties": {
    "toolchain": { "type": "string", "default": "stable" },
    "target": { "type": "string" },
    "profile": { "type": "string" },
    "release": { "type": "boolean", "default": false },
    "target-dir": { "type": "string" },
    "features": {
      "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }]
    },
    "all-features": { "type": "boolean", "default": false },
    "no-default-features": { "type": "boolean", "default": false },
    "locked": { "type": "boolean", "default": false },
    "frozen": { "type": "boolean", "default": false },
    "offline": { "type": "boolean", "default": false },
    "package": { "type": "string" },
    "bin": {
      "type": "string",
      "description": "Binary to run — required when the crate has multiple binaries."
    },
    "example": { "type": "string" },
    "args": {
      "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }],
      "description": "Arguments forwarded to the binary after `--`."
    }
  },
  "required": []
}
