{
  "$schema": "http://json-schema.org/schema",
  "version": 2,
  "outputCapture": "direct-nodejs",
  "title": "@eddacraft/nx-rust:release-publish",
  "description": "Publish a Rust crate. Invoked by `nx release publish`.",
  "type": "object",
  "properties": {
    "toolchain": { "type": "string", "default": "stable" },
    "package": { "type": "string" },
    "registry": { "type": "string", "description": "--registry <name>." },
    "token": {
      "type": "string",
      "description": "--token (AVOID; prefer CARGO_REGISTRY_TOKEN env var so the value never lands in project.json, CI logs, or process listings).",
      "x-secret": true
    },
    "allowDirty": { "type": "boolean", "default": false },
    "dryRun": { "type": "boolean", "default": false },
    "noVerify": {
      "type": "boolean",
      "default": false,
      "description": "Skip package verification build."
    },
    "args": {
      "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }]
    }
  },
  "required": []
}
