# Vendored package — dist/ IS committed here so Nx can load the plugin at
# startup without an install-time build step. See SPLIT.md.
#
# NOTE: this file diverges from the upstream eddacraft/nxrust repo, which
# gitignores dist/. Keep this in mind when syncing back.

node_modules/
coverage/
.nx/
*.tsbuildinfo
.DS_Store
.env
.env.local

# Re-include only the package-level dist/ (rooted with leading slash so
# nested dist/ subdirectories — e.g. inside generator templates — stay
# ignored per the root rule). The root .gitignore excludes `dist`
# project-wide.
!/dist/
