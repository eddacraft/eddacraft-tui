{
  "$schema": "http://json-schema.org/schema",
  "$id": "NxRustReleaseVersion",
  "title": "nxrust:release-version",
  "description": "Bump a Cargo crate's version in Cargo.toml. Invoked via `nx release version`.",
  "type": "object",
  "properties": {
    "projects": {
      "type": "array",
      "items": { "type": "string" }
    },
    "projectGraph": { "type": "object" },
    "releaseGroup": { "type": "object" },
    "specifier": { "type": "string" },
    "specifierSource": { "type": "string" },
    "currentVersionResolver": { "type": "string" },
    "currentVersionResolverMetadata": { "type": "object" },
    "fallbackCurrentVersionResolver": { "type": "string" },
    "firstRelease": { "type": "boolean" },
    "preid": { "type": "string" }
  }
}
