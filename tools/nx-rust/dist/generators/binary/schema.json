{
  "$schema": "http://json-schema.org/schema",
  "$id": "NxRustBinary",
  "title": "@eddacraft/nx-rust:binary",
  "description": "Scaffold a new Cargo binary crate.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "$default": { "$source": "argv", "index": 0 },
      "x-prompt": "What name would you like to use for the binary?"
    },
    "directory": { "type": "string", "default": "crates" },
    "edition": {
      "type": "string",
      "enum": ["2015", "2018", "2021", "2024"],
      "default": "2021"
    },
    "description": { "type": "string" },
    "tags": { "type": "string" },
    "skipFormat": { "type": "boolean", "default": false }
  },
  "required": ["name"]
}
