{
  "$schema": "http://json-schema.org/schema",
  "version": 2,
  "outputCapture": "direct-nodejs",
  "title": "@eddacraft/nx-rust:build",
  "description": "Build a Rust crate with `cargo build`.",
  "type": "object",
  "properties": {
    "toolchain": {
      "type": "string",
      "description": "Rust toolchain (stable, beta, nightly, or a specific pin).",
      "default": "stable"
    },
    "target": {
      "type": "string",
      "description": "Rust target triple (e.g. x86_64-unknown-linux-gnu)."
    },
    "profile": {
      "type": "string",
      "description": "Cargo profile name (wins over `release`)."
    },
    "release": {
      "type": "boolean",
      "description": "Shortcut for --release.",
      "default": false
    },
    "target-dir": {
      "type": "string",
      "description": "Override `target/` directory."
    },
    "features": {
      "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }],
      "description": "Feature flags."
    },
    "all-features": {
      "type": "boolean",
      "default": false
    },
    "no-default-features": {
      "type": "boolean",
      "default": false
    },
    "locked": { "type": "boolean", "default": false },
    "frozen": { "type": "boolean", "default": false },
    "offline": { "type": "boolean", "default": false },
    "package": {
      "type": "string",
      "description": "Cargo package name if it differs from the Nx project name."
    },
    "lib": { "type": "boolean", "default": false, "description": "Build the package's library." },
    "bin": {
      "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }]
    },
    "bins": { "type": "boolean", "default": false },
    "example": {
      "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }]
    },
    "examples": { "type": "boolean", "default": false },
    "all-targets": { "type": "boolean", "default": false },
    "args": {
      "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }],
      "description": "Raw passthrough args (appear after --)."
    }
  },
  "required": []
}
