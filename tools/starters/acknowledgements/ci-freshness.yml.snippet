# Drop this job into a GitHub Actions workflow to fail CI when
# ACKNOWLEDGEMENTS.md drifts. Uncomment only the setup for ecosystems
# you actually declare in attribution.toml.
#
# SECURITY: The action references below use floating tags (@v4, @v6)
# for readability. Before using this snippet in a real workflow, replace
# every `@<tag>` with the corresponding full commit SHA.

acknowledgements-diff:
  name: Acknowledgements freshness
  runs-on: ubuntu-latest
  steps:
    - uses: actions/checkout@v6 # pin to commit SHA before merging

    # Node block: uncomment the next two steps.
    # - uses: actions/setup-node@v4 # pin to commit SHA before merging
    #   with:
    #     node-version: '20'
    # - run: npm ci

    # Rust block: uncomment the next two steps.
    # - uses: actions-rust-lang/setup-rust-toolchain@v1 # pin to commit SHA before merging
    # - uses: taiki-e/install-action@v2 # pin to commit SHA before merging
    #   with:
    #     tool: cargo-about@0.8.4

    # Go block: uncomment and put go-licenses on PATH.
    # - uses: actions/setup-go@v5 # pin to commit SHA before merging
    # - run: go install github.com/google/go-licenses@v1.6.0

    # Python block: the driver uses the consumer-supplied venv.
    # - uses: actions/setup-python@v5 # pin to commit SHA before merging

    - name: Acknowledgements freshness
      run: |
        if ! tools/starters/acknowledgements/generate-acknowledgements.sh --check; then
          echo "::error::ACKNOWLEDGEMENTS.md is stale. Re-run the generator locally and commit."
          exit 1
        fi

    # If you keep licences.toml, uncomment:
    # - name: Licences single-source drift check
    #   run: tools/starters/acknowledgements/expand-licences.sh --check
