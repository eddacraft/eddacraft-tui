{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "CommandGenerator",
  "title": "Create CLI Command",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Command name in kebab-case (e.g., my-command)",
      "$default": {
        "$source": "argv",
        "index": 0
      },
      "x-prompt": "What is the command name (kebab-case)?"
    },
    "description": {
      "type": "string",
      "description": "Command description"
    }
  },
  "required": ["name"]
}
