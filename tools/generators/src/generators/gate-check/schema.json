{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "GateCheck",
  "title": "Create Gate Check",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Gate check name in kebab-case (e.g., my-check)",
      "$default": {
        "$source": "argv",
        "index": 0
      },
      "x-prompt": "What is the gate check name (kebab-case)?"
    },
    "description": {
      "type": "string",
      "description": "Gate check description"
    }
  },
  "required": ["name"]
}
