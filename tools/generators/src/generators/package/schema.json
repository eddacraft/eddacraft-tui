{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Package",
  "title": "Create Package",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Package name (without @anvil/ prefix)",
      "$default": {
        "$source": "argv",
        "index": 0
      },
      "x-prompt": "What is the package name?"
    },
    "directory": {
      "type": "string",
      "description": "Parent directory (packages/anvil, packages/platform, etc.)",
      "default": "packages",
      "enum": [
        "packages",
        "packages/anvil",
        "packages/platform",
        "packages/shared",
        "packages/tooling",
        "packages/adapters"
      ],
      "x-prompt": {
        "message": "Which directory should the package be in?",
        "type": "list",
        "items": [
          { "value": "packages", "label": "packages/ (top-level package)" },
          { "value": "packages/anvil", "label": "packages/anvil/ (core domain)" },
          { "value": "packages/platform", "label": "packages/platform/ (infrastructure)" },
          { "value": "packages/shared", "label": "packages/shared/ (utilities)" },
          { "value": "packages/tooling", "label": "packages/tooling/ (build config)" },
          { "value": "packages/adapters", "label": "packages/adapters/ (integrations)" }
        ]
      }
    },
    "description": {
      "type": "string",
      "description": "Package description"
    },
    "publishable": {
      "type": "boolean",
      "description": "Whether this package should be publishable to npm",
      "default": false
    }
  },
  "required": ["name"]
}
