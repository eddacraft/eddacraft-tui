{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "AnvilPackage",
  "title": "Create Anvil Package",
  "description": "Create a new package in packages/anvil/ for core domain",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Package name (contracts, ports, core, runtime, policy, sdk)",
      "$default": {
        "$source": "argv",
        "index": 0
      },
      "enum": ["contracts", "ports", "core", "runtime", "policy", "sdk"],
      "x-prompt": {
        "message": "Which anvil package do you want to create?",
        "type": "list",
        "items": [
          { "value": "contracts", "label": "contracts - Schemas, types, events (zero deps)" },
          { "value": "ports", "label": "ports - Interfaces only (depends on contracts)" },
          { "value": "core", "label": "core - Pure domain logic (depends on ports)" },
          { "value": "runtime", "label": "runtime - Orchestration + I/O (depends on core)" },
          { "value": "policy", "label": "policy - OPA/Rego wrappers (depends on contracts)" },
          { "value": "sdk", "label": "sdk - Client SDK (depends on contracts, ports)" }
        ]
      }
    },
    "description": {
      "type": "string",
      "description": "Package description"
    }
  },
  "required": ["name"]
}
