/plans
pnpm-lock.yaml
**/next-env.d.ts
# Build artifacts from Docusaurus docs site
/apps/docs-site/build/
/apps/docs-site/.docusaurus/
# Temper workflow contains large multi-line prompt blocks that break YAML parsing
.github/workflows/temper.yml
# Claude review workflow must match default branch exactly for action validation
.github/workflows/claude-code-review.yml
# Semgrep rules use DSL patterns that aren't valid YAML for Prettier
.semgrep/
# Claude Code dev tooling — agents, hooks, council sessions, skills
.claude/
# opencode dev tooling — vendored agents + skills, parallel to .claude/. Skill
# files embed copy/paste templates inside fenced ```markdown blocks that oxfmt
# reflows and corrupts (e.g. merging distinct template lines into one paragraph).
.opencode/
# Codex dev tooling — repo-local config + skills, parallel to .claude/ and
# .opencode/. Same fenced ```markdown corruption applies to the skill files.
.codex/
# Cross-harness skills — APS-managed byte inventories shared by Codex and other
# AGENTS.md-native runtimes. Formatting would invalidate their managed markers.
.agents/
# GitHub Copilot dev tooling — vendored APS agents, parallel to .claude/ and
# .agents/. Vendored verbatim from the canonical agent package, so formatting
# only churns: oxfmt folds the single-line frontmatter `description:` into a
# multi-line scalar and rewraps prose, and the next vendoring reverts it.
.github/agents/
archive/
# cargo-about Handlebars template — oxfmt parses .hbs as Glimmer and rejects
# handlebars parent-scope access like {{../name}}. Template is authoritative.
attribution/about.hbs
# ACKNOWLEDGEMENTS.md has a hand-curated top + auto-generated attribution
# block; tools/generate-acknowledgements.sh is the source of truth.
ACKNOWLEDGEMENTS.md
# Public install landing page is hand-curated HTML. oxfmt wraps command
# text (breaking white-space:pre boxes) and splits id="version-tag"> so
# the eddacraft/anvil stamp-install-page.yml sed no longer matches.
scripts/install/public-site/index.html
# workspace-hack Cargo.toml is generated and rewritten by cargo-hakari;
# oxfmt and hakari disagree on TOML style. Hakari owns this file.
crates/workspace-hack/Cargo.toml
# Editor-coexistence harness fixtures (ADOPT-006) are isolated workspaces
# checked by the harness itself — they each carry their own prettier /
# eslint / ruff configs.
tools/test-harness/editor-coexistence/fixtures/
# Vendored upstream SARIF 2.1.0 JSON Schema (SARIFOUT). Bundled verbatim from
# schemastore for the schema-validation harness; must stay byte-identical to
# upstream (no schema fork), so it is not reformatted. Lives in anvil-sarif
# since GITGOV-008 (relocated from anvil-cli/src/output/).
crates/anvil-sarif/src/sarif-schema-2.1.0.json
# Vendored upstream tree-sitter-wat grammar (LTW2-002, ADR-093). The generated
# parser.c, its header, the upstream LICENSE, and the provenance README are
# bundled verbatim from wasm-lsp/tree-sitter-wasm and must not be reformatted.
crates/anvil-grammar-wat/vendor/
# Token-cost experiment artifacts must stay byte-exact: source.md is a
# frozen snapshot of plans/modules/tui-dashboard-render.aps.md and the two
# HTML files are the comparison output of convert.mjs. Formatting them
# would invalidate the comparison.
docs/archive/experiments/html-vs-markdown-tokens/source.md
docs/archive/experiments/html-vs-markdown-tokens/source.minimal.html
docs/archive/experiments/html-vs-markdown-tokens/source.structured.html
# Golden render fixture must stay byte-identical to the scorecard renderer output
crates/anvil-cli/src/insights/testdata/
# dev-loop orchestration state (run checkpoints); not product content
.dev-loop/
