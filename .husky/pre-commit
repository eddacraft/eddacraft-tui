#!/bin/sh
# Run lint-staged via pnpm to avoid npm reading pnpm-specific .npmrc settings
if command -v pnpm >/dev/null 2>&1; then
  pnpm exec lint-staged
elif command -v npx >/dev/null 2>&1; then
  # Fallback to npx if pnpm not available
  npx lint-staged
else
  echo "Neither pnpm nor npx found. Please install pnpm or Node.js."
  exit 1
fi
