#!/bin/sh
set -e

run_node_tool() {
  if command -v pnpm >/dev/null 2>&1; then
    pnpm exec "$@"
  elif command -v npx >/dev/null 2>&1; then
    npx "$@"
  else
    echo "Neither pnpm nor npx found. Please install pnpm or Node.js."
    exit 1
  fi
}

run_oxfmt_check_on_staged_files() {
  if command -v pnpm >/dev/null 2>&1; then
    git diff --cached --name-only --diff-filter=ACMR -z -- '*.js' '*.jsx' '*.ts' '*.tsx' '*.json' '*.yml' '*.yaml' |
      xargs -0 sh -c '
        [ "$#" -eq 0 ] && exit 0
        pnpm exec oxfmt --check -- "$@"
      ' sh
  elif command -v npx >/dev/null 2>&1; then
    git diff --cached --name-only --diff-filter=ACMR -z -- '*.js' '*.jsx' '*.ts' '*.tsx' '*.json' '*.yml' '*.yaml' |
      xargs -0 sh -c '
        [ "$#" -eq 0 ] && exit 0
        npx oxfmt --check -- "$@"
      ' sh
  else
    echo "Neither pnpm nor npx found. Please install pnpm or Node.js."
    exit 1
  fi
}

run_node_tool lint-staged

# lint-staged formats and re-stages supported files; re-check them here so
# commits fail fast if any staged JS/TS/JSON/YAML still bypassed oxfmt.
run_oxfmt_check_on_staged_files
