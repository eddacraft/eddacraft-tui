#!/bin/sh
set -e

run_node_tool() {
  if command -v pnpm >/dev/null 2>&1; then
    pnpm exec "$@"
  elif command -v npx >/dev/null 2>&1; then
    npx "$@"
  else
    echo "Neither pnpm nor npx found. Please install pnpm or Node.js."
    exit 1
  fi
}

run_node_tool lint-staged

# lint-staged formats and re-stages supported files; re-check them here so
# commits fail fast if any staged JS/TS/JSON/YAML still bypassed oxfmt.
staged_oxfmt_files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.js' '*.jsx' '*.ts' '*.tsx' '*.json' '*.yml' '*.yaml')

if [ -n "$staged_oxfmt_files" ]; then
  run_node_tool oxfmt --check $staged_oxfmt_files
fi
