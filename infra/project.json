{
  "name": "@eddacraft/anvil-infra",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "infra/src",
  "projectType": "application",
  "tags": ["scope:infra"],
  "targets": {
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pulumi preview",
        "cwd": "infra"
      }
    },
    "up": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pulumi up",
        "cwd": "infra"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec tsc --noEmit",
        "cwd": "infra"
      }
    }
  }
}
