{
  "title": "Architecture Health",
  "description": "Dashboard combining anvil architecture validate results and anvil watch boundary monitoring — shows health score, violation counts by severity, boundary violation details, and rule compliance summary.",
  "version": "1.0",
  "root": "page",
  "elements": {
    "page": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "lg"
      },
      "children": [
        "header",
        "severity-grid",
        "separator-1",
        "violations-section",
        "separator-2",
        "compliance-section"
      ]
    },
    "header": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "md",
        "align": "center",
        "justify": "between"
      },
      "children": ["title", "health-score"]
    },
    "title": {
      "type": "Heading",
      "props": {
        "children": "Architecture Health",
        "level": 2
      },
      "children": []
    },
    "health-score": {
      "type": "MetricCard",
      "props": {
        "label": "Health Score",
        "value": "81",
        "trend": "up",
        "format": "percent"
      },
      "children": []
    },
    "severity-grid": {
      "type": "Grid",
      "props": {
        "columns": 4,
        "gap": "md"
      },
      "children": ["sev-error", "sev-warning", "sev-info", "sev-total"]
    },
    "sev-error": {
      "type": "MetricCard",
      "props": {
        "label": "Errors",
        "value": "2",
        "trend": "down",
        "format": "number"
      },
      "children": []
    },
    "sev-warning": {
      "type": "MetricCard",
      "props": {
        "label": "Warnings",
        "value": "5",
        "trend": "flat",
        "format": "number"
      },
      "children": []
    },
    "sev-info": {
      "type": "MetricCard",
      "props": {
        "label": "Info",
        "value": "3",
        "format": "number"
      },
      "children": []
    },
    "sev-total": {
      "type": "MetricCard",
      "props": {
        "label": "Total Violations",
        "value": "10",
        "trend": "down",
        "format": "number"
      },
      "children": []
    },
    "separator-1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      },
      "children": []
    },
    "violations-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": ["violations-heading", "violations-table"]
    },
    "violations-heading": {
      "type": "Heading",
      "props": {
        "children": "Boundary Violations",
        "level": 3
      },
      "children": []
    },
    "violations-table": {
      "type": "Table",
      "props": {
        "columns": ["From", "To", "Rule", "Severity"],
        "rows": [
          [
            "anvil-archive/anvil-mcp-server/src/tools/fix.tool.ts",
            "packages/anvil/runtime/src/gate/checks/policy.check.ts",
            "mcp-must-not-import-runtime-internals",
            "error"
          ],
          [
            "packages/anvil/runtime/src/watch/git-status.ts",
            "packages/edda-stack/src/edda/memory-store.ts",
            "runtime-must-not-import-edda-internals",
            "error"
          ],
          [
            "packages/anvil/core/src/config/loader.ts",
            "packages/aps/src/state/index.ts",
            "core-should-use-contracts-not-aps-state",
            "warning"
          ],
          [
            "apps/anvil-api/src/routes/admin.ts",
            "packages/edda-stack/src/ember/query-api.ts",
            "api-should-use-port-interface",
            "warning"
          ],
          [
            "anvil-archive/anvil-mcp-server/src/tools/fix.tool.ts",
            "packages/anvil/core/src/config/loader.ts",
            "mcp-should-use-runtime-facade",
            "warning"
          ],
          [
            "apps/anvil-api/src/routes/auth-session.ts",
            "packages/anvil/core/src/config/loader.ts",
            "api-prefer-contracts-over-core",
            "warning"
          ],
          [
            "packages/anvil/runtime/src/gate/gate-config.ts",
            "packages/edda-stack/src/contracts/provenance.ts",
            "runtime-prefer-contracts-path",
            "warning"
          ],
          [
            "apps/website/lib/utils.ts",
            "packages/platform/storage/src/file-storage.ts",
            "website-must-not-import-runtime",
            "info"
          ],
          [
            "packages/platform/config/src/loader.ts",
            "packages/anvil/core/src/config/loader.ts",
            "platform-should-be-independent",
            "info"
          ],
          [
            "packages/anvil/runtime/src/gate/gate-runner.ts",
            "packages/edda-stack/src/contracts/temporal.ts",
            "core-gate-prefer-local-types",
            "info"
          ]
        ],
        "caption": "10 boundary violations across 8 architectural rules"
      },
      "children": []
    },
    "separator-2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      },
      "children": []
    },
    "compliance-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": ["compliance-heading", "compliance-list"]
    },
    "compliance-heading": {
      "type": "Heading",
      "props": {
        "children": "Rule Compliance Summary",
        "level": 3
      },
      "children": []
    },
    "compliance-list": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "children": [
        "rule-layer-isolation",
        "rule-contracts-boundary",
        "rule-cli-boundary",
        "rule-port-interface",
        "rule-runtime-facade",
        "rule-no-circular"
      ]
    },
    "rule-layer-isolation": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "sm",
        "align": "center"
      },
      "children": ["rule-layer-badge", "rule-layer-text"]
    },
    "rule-layer-badge": {
      "type": "Badge",
      "props": {
        "children": "FAIL",
        "variant": "destructive"
      },
      "children": []
    },
    "rule-layer-text": {
      "type": "Text",
      "props": {
        "children": "Layer isolation — 2 violations (runtime imports edda-stack internals, cli imports runtime internals)",
        "variant": "body"
      },
      "children": []
    },
    "rule-contracts-boundary": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "sm",
        "align": "center"
      },
      "children": ["rule-contracts-badge", "rule-contracts-text"]
    },
    "rule-contracts-badge": {
      "type": "Badge",
      "props": {
        "children": "WARN",
        "variant": "secondary"
      },
      "children": []
    },
    "rule-contracts-text": {
      "type": "Text",
      "props": {
        "children": "Contracts-first boundary — 3 modules bypassing contract interfaces",
        "variant": "body"
      },
      "children": []
    },
    "rule-cli-boundary": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "sm",
        "align": "center"
      },
      "children": ["rule-cli-badge", "rule-cli-text"]
    },
    "rule-cli-badge": {
      "type": "Badge",
      "props": {
        "children": "WARN",
        "variant": "secondary"
      },
      "children": []
    },
    "rule-cli-text": {
      "type": "Text",
      "props": {
        "children": "CLI boundary — 1 command importing port implementation instead of interface",
        "variant": "body"
      },
      "children": []
    },
    "rule-port-interface": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "sm",
        "align": "center"
      },
      "children": ["rule-port-badge", "rule-port-text"]
    },
    "rule-port-badge": {
      "type": "Badge",
      "props": {
        "children": "WARN",
        "variant": "secondary"
      },
      "children": []
    },
    "rule-port-text": {
      "type": "Text",
      "props": {
        "children": "Port interface usage — 1 module bypassing port contract (api routes importing edda internals)",
        "variant": "body"
      },
      "children": []
    },
    "rule-runtime-facade": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "sm",
        "align": "center"
      },
      "children": ["rule-facade-badge", "rule-facade-text"]
    },
    "rule-facade-badge": {
      "type": "Badge",
      "props": {
        "children": "WARN",
        "variant": "secondary"
      },
      "children": []
    },
    "rule-facade-text": {
      "type": "Text",
      "props": {
        "children": "Runtime facade — MCP server accessing core directly (should use runtime facade)",
        "variant": "body"
      },
      "children": []
    },
    "rule-no-circular": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "sm",
        "align": "center"
      },
      "children": ["rule-circular-badge", "rule-circular-text"]
    },
    "rule-circular-badge": {
      "type": "Badge",
      "props": {
        "children": "PASS",
        "variant": "default"
      },
      "children": []
    },
    "rule-circular-text": {
      "type": "Text",
      "props": {
        "children": "No circular dependencies — dependency graph is acyclic",
        "variant": "body"
      },
      "children": []
    }
  }
}
