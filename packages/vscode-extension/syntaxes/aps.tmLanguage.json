{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "APS Markdown",
  "scopeName": "text.markdown.aps",
  "patterns": [
    { "include": "#frontmatter" },
    { "include": "#aps-comment" },
    { "include": "#task-table" },
    { "include": "#status-badge" },
    { "include": "#task-id" },
    { "include": "#priority-marker" },
    { "include": "#section-header" },
    { "include": "text.html.markdown" }
  ],
  "repository": {
    "frontmatter": {
      "name": "meta.embedded.block.frontmatter.aps",
      "begin": "\\A(-{3})\\s*$",
      "end": "^(-{3})\\s*$",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.frontmatter.begin.aps" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.frontmatter.end.aps" }
      },
      "patterns": [{ "include": "source.yaml" }]
    },
    "aps-comment": {
      "name": "comment.block.aps",
      "match": "<!--\\s*APS:.*?-->",
      "captures": {
        "0": { "name": "comment.block.documentation.aps" }
      }
    },
    "task-table": {
      "name": "meta.table.task.aps",
      "begin": "^\\|\\s*Task\\s*\\|",
      "end": "^(?!\\|)",
      "patterns": [{ "include": "#table-separator" }, { "include": "#task-row" }]
    },
    "table-separator": {
      "name": "punctuation.separator.table.aps",
      "match": "^\\|[-:\\s|]+\\|\\s*$"
    },
    "task-row": {
      "name": "meta.table.row.aps",
      "match": "^\\|(.+)\\|\\s*$",
      "captures": {
        "1": {
          "patterns": [
            { "include": "#task-id" },
            { "include": "#status-badge" },
            { "include": "#priority-marker" }
          ]
        }
      }
    },
    "task-id": {
      "name": "entity.name.tag.task-id.aps",
      "match": "\\b([A-Z]{2,6}-\\d{3})\\b",
      "captures": {
        "1": { "name": "entity.name.function.task-id.aps" }
      }
    },
    "status-badge": {
      "patterns": [
        {
          "name": "constant.language.status.done.aps",
          "match": "\\b(Done|Complete|Completed|✅)\\b"
        },
        {
          "name": "constant.language.status.ready.aps",
          "match": "\\b(Ready|In Progress|🔄)\\b"
        },
        {
          "name": "constant.language.status.planned.aps",
          "match": "\\b(Planned|Draft|Pending|⏳)\\b"
        },
        {
          "name": "constant.language.status.blocked.aps",
          "match": "\\b(Blocked|Cancelled|❌)\\b"
        }
      ]
    },
    "priority-marker": {
      "patterns": [
        {
          "name": "keyword.other.priority.high.aps",
          "match": "\\b(high|critical|P0|P1)\\b"
        },
        {
          "name": "keyword.other.priority.medium.aps",
          "match": "\\b(medium|P2)\\b"
        },
        {
          "name": "keyword.other.priority.low.aps",
          "match": "\\b(low|P3|P4)\\b"
        }
      ]
    },
    "section-header": {
      "patterns": [
        {
          "name": "markup.heading.aps.purpose",
          "match": "^##\\s+(Purpose|Overview|Problem|Goal)\\b"
        },
        {
          "name": "markup.heading.aps.scope",
          "match": "^##\\s+(In Scope|Out of Scope|Scope|Constraints)\\b"
        },
        {
          "name": "markup.heading.aps.tasks",
          "match": "^##\\s+(Tasks|Milestones|Deliverables|Requirements)\\b"
        },
        {
          "name": "markup.heading.aps.interfaces",
          "match": "^##\\s+(Interfaces|Dependencies|Exposes|Depends on)\\b"
        },
        {
          "name": "markup.heading.aps.criteria",
          "match": "^##\\s+(Acceptance Criteria|Success Criteria|Definition of Done)\\b"
        },
        {
          "name": "markup.heading.aps.risks",
          "match": "^##\\s+(Risks|Open Questions|Assumptions)\\b"
        }
      ]
    }
  }
}
