{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Rego",
  "scopeName": "source.rego",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#builtins" },
    { "include": "#operators" },
    { "include": "#package-import" },
    { "include": "#rule-definition" },
    { "include": "#variables" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.rego",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.rego",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.rego",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.backtick.rego",
          "begin": "`",
          "end": "`"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.rego",
          "match": "\\b\\d+\\.\\d+([eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.integer.rego",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.rego",
          "match": "\\b(if|else|not|with|as|default|some|every|in|contains)\\b"
        },
        {
          "name": "constant.language.rego",
          "match": "\\b(true|false|null)\\b"
        },
        {
          "name": "keyword.other.package.rego",
          "match": "\\b(package)\\b"
        },
        {
          "name": "keyword.other.import.rego",
          "match": "\\b(import)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.aggregate.rego",
          "match": "\\b(count|sum|product|max|min|sort|all|any)\\b"
        },
        {
          "name": "support.function.array.rego",
          "match": "\\b(array\\.concat|array\\.slice|array\\.reverse)\\b"
        },
        {
          "name": "support.function.set.rego",
          "match": "\\b(intersection|union)\\b"
        },
        {
          "name": "support.function.object.rego",
          "match": "\\b(object\\.get|object\\.remove|object\\.union|object\\.filter|object\\.keys)\\b"
        },
        {
          "name": "support.function.string.rego",
          "match": "\\b(concat|contains|endswith|format_int|indexof|lower|replace|split|sprintf|startswith|substring|trim|trim_left|trim_prefix|trim_right|trim_suffix|trim_space|upper)\\b"
        },
        {
          "name": "support.function.regex.rego",
          "match": "\\b(regex\\.match|regex\\.split|regex\\.globs_match|regex\\.template_match|regex\\.find_n|regex\\.find_all_string_submatch_n)\\b"
        },
        {
          "name": "support.function.glob.rego",
          "match": "\\b(glob\\.match|glob\\.quote_meta)\\b"
        },
        {
          "name": "support.function.comparison.rego",
          "match": "\\b(equal|gte|gt|lte|lt|neq)\\b"
        },
        {
          "name": "support.function.type.rego",
          "match": "\\b(is_array|is_boolean|is_null|is_number|is_object|is_set|is_string|type_name)\\b"
        },
        {
          "name": "support.function.encoding.rego",
          "match": "\\b(base64\\.decode|base64\\.encode|base64url\\.decode|base64url\\.encode|urlquery\\.decode|urlquery\\.encode|json\\.marshal|json\\.unmarshal|yaml\\.marshal|yaml\\.unmarshal)\\b"
        },
        {
          "name": "support.function.crypto.rego",
          "match": "\\b(crypto\\.md5|crypto\\.sha1|crypto\\.sha256|crypto\\.x509\\.parse_certificates)\\b"
        },
        {
          "name": "support.function.graph.rego",
          "match": "\\b(graph\\.reachable|walk)\\b"
        },
        {
          "name": "support.function.http.rego",
          "match": "\\b(http\\.send)\\b"
        },
        {
          "name": "support.function.net.rego",
          "match": "\\b(net\\.cidr_contains|net\\.cidr_intersects|net\\.cidr_expand|net\\.cidr_merge)\\b"
        },
        {
          "name": "support.function.opa.rego",
          "match": "\\b(opa\\.runtime|rego\\.parse_module|trace|print)\\b"
        },
        {
          "name": "support.function.time.rego",
          "match": "\\b(time\\.now_ns|time\\.parse_ns|time\\.parse_rfc3339_ns|time\\.parse_duration_ns|time\\.date|time\\.clock|time\\.weekday|time\\.add_date|time\\.diff)\\b"
        },
        {
          "name": "support.function.uuid.rego",
          "match": "\\b(uuid\\.rfc4122)\\b"
        },
        {
          "name": "support.function.semver.rego",
          "match": "\\b(semver\\.is_valid|semver\\.compare)\\b"
        },
        {
          "name": "support.function.io.rego",
          "match": "\\b(io\\.jwt\\.decode|io\\.jwt\\.decode_verify|io\\.jwt\\.encode_sign|io\\.jwt\\.encode_sign_raw|io\\.jwt\\.verify_es256|io\\.jwt\\.verify_es384|io\\.jwt\\.verify_es512|io\\.jwt\\.verify_hs256|io\\.jwt\\.verify_hs384|io\\.jwt\\.verify_hs512|io\\.jwt\\.verify_ps256|io\\.jwt\\.verify_ps384|io\\.jwt\\.verify_ps512|io\\.jwt\\.verify_rs256|io\\.jwt\\.verify_rs384|io\\.jwt\\.verify_rs512)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.rego",
          "match": ":=|="
        },
        {
          "name": "keyword.operator.comparison.rego",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.arithmetic.rego",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.logical.rego",
          "match": "&|\\|"
        },
        {
          "name": "punctuation.accessor.rego",
          "match": "\\."
        },
        {
          "name": "punctuation.separator.rego",
          "match": ",|;"
        }
      ]
    },
    "package-import": {
      "patterns": [
        {
          "name": "meta.package.rego",
          "match": "^\\s*(package)\\s+([a-zA-Z_][a-zA-Z0-9_\\.]*)",
          "captures": {
            "1": { "name": "keyword.other.package.rego" },
            "2": { "name": "entity.name.namespace.rego" }
          }
        },
        {
          "name": "meta.import.rego",
          "match": "^\\s*(import)\\s+([a-zA-Z_][a-zA-Z0-9_\\.]*)(\\s+(as)\\s+([a-zA-Z_][a-zA-Z0-9_]*))?",
          "captures": {
            "1": { "name": "keyword.other.import.rego" },
            "2": { "name": "entity.name.namespace.rego" },
            "4": { "name": "keyword.other.as.rego" },
            "5": { "name": "entity.name.alias.rego" }
          }
        }
      ]
    },
    "rule-definition": {
      "patterns": [
        {
          "name": "meta.rule.default.rego",
          "match": "^\\s*(default)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*=",
          "captures": {
            "1": { "name": "keyword.other.default.rego" },
            "2": { "name": "entity.name.function.rule.rego" }
          }
        },
        {
          "name": "meta.rule.rego",
          "match": "^([a-zA-Z_][a-zA-Z0-9_]*)(?:\\s*\\[|\\s*\\{|\\s*=|\\s*:=|\\s+if\\b|\\s+contains\\b)",
          "captures": {
            "1": { "name": "entity.name.function.rule.rego" }
          }
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.rego",
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
        },
        {
          "name": "variable.language.input.rego",
          "match": "\\binput\\b"
        },
        {
          "name": "variable.language.data.rego",
          "match": "\\bdata\\b"
        }
      ]
    }
  }
}
