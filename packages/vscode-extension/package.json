{
  "name": "anvil-vscode",
  "displayName": "Anvil",
  "description": "Deterministic validation and quality gates for AI-generated code plans. Catch architecture violations and anti-patterns at save time.",
  "version": "0.1.0",
  "publisher": "eddacraft",
  "icon": "resources/anvil-icon.png",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "badges": [
    {
      "url": "https://img.shields.io/github/actions/workflow/status/EddaCraft/anvil-001/ci.yml?branch=main&style=flat-square",
      "href": "https://github.com/EddaCraft/anvil-001/actions",
      "description": "Build Status"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/EddaCraft/anvil-001.git",
    "directory": "packages/vscode-extension"
  },
  "homepage": "https://github.com/EddaCraft/anvil-001#readme",
  "bugs": {
    "url": "https://github.com/EddaCraft/anvil-001/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Testing",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "anvil",
    "validation",
    "quality-gates",
    "ai-safety",
    "speckit",
    "planning",
    "architecture",
    "anti-patterns",
    "rego",
    "opa"
  ],
  "activationEvents": [
    "workspaceContains:**/plan.md",
    "workspaceContains:**/*.plan.md",
    "workspaceContains:**/spec.md",
    "workspaceContains:**/*.aps.json",
    "workspaceContains:.anvilrc"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "anvil.validate",
        "title": "Validate Plan",
        "category": "Anvil",
        "icon": "$(check)"
      },
      {
        "command": "anvil.gate",
        "title": "Run Quality Gates",
        "category": "Anvil",
        "icon": "$(shield)"
      },
      {
        "command": "anvil.validateCurrentFile",
        "title": "Validate Current File",
        "category": "Anvil",
        "icon": "$(check)"
      },
      {
        "command": "anvil.gateCurrentFile",
        "title": "Run Gates on Current File",
        "category": "Anvil",
        "icon": "$(shield)"
      },
      {
        "command": "anvil.export",
        "title": "Export Plan",
        "category": "Anvil",
        "icon": "$(export)"
      },
      {
        "command": "anvil.refresh",
        "title": "Refresh",
        "category": "Anvil",
        "icon": "$(refresh)"
      },
      {
        "command": "anvil.showOutput",
        "title": "Show Output",
        "category": "Anvil",
        "icon": "$(output)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "anvilGateResults",
          "name": "Anvil Gate Results",
          "when": "anvil.hasPlans",
          "contextualTitle": "Anvil"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "anvil",
          "title": "Anvil",
          "icon": "resources/anvil-icon.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "anvil.refresh",
          "when": "view == anvilGateResults",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "anvil.validateCurrentFile",
          "when": "anvil.isPlanFile",
          "group": "navigation@1"
        },
        {
          "command": "anvil.gateCurrentFile",
          "when": "anvil.isPlanFile",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "anvil.validateCurrentFile",
          "when": "anvil.isPlanFile",
          "group": "anvil@1"
        },
        {
          "command": "anvil.gateCurrentFile",
          "when": "anvil.isPlanFile",
          "group": "anvil@2"
        },
        {
          "command": "anvil.export",
          "when": "anvil.isPlanFile",
          "group": "anvil@3"
        }
      ],
      "commandPalette": [
        {
          "command": "anvil.validateCurrentFile",
          "when": "editorIsOpen"
        },
        {
          "command": "anvil.gateCurrentFile",
          "when": "editorIsOpen"
        }
      ]
    },
    "configuration": {
      "title": "Anvil",
      "properties": {
        "anvil.autoValidate": {
          "type": "boolean",
          "default": true,
          "description": "Automatically validate plan files on save"
        },
        "anvil.validateOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "Validate plan files when opened"
        },
        "anvil.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show Anvil status in the status bar"
        },
        "anvil.defaultFormat": {
          "type": "string",
          "enum": [
            "auto",
            "speckit",
            "bmad",
            "generic",
            "aps"
          ],
          "default": "auto",
          "description": "Default format for plan detection (auto = detect automatically)"
        },
        "anvil.gates.enabled": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "lint",
              "test",
              "coverage",
              "secrets",
              "dependencies"
            ]
          },
          "default": [
            "lint",
            "test",
            "coverage",
            "secrets",
            "dependencies"
          ],
          "description": "Which quality gates to run"
        },
        "anvil.gates.skipInDevelopment": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Gates to skip during development (still enforced in CI)"
        },
        "anvil.coverage.threshold": {
          "type": "number",
          "default": 80,
          "minimum": 0,
          "maximum": 100,
          "description": "Minimum coverage percentage required"
        },
        "anvil.cli.path": {
          "type": "string",
          "default": "",
          "description": "Path to Anvil CLI (leave empty to use globally installed)"
        },
        "anvil.showCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show CodeLens actions above plan files"
        }
      }
    },
    "languages": [
      {
        "id": "aps-json",
        "aliases": [
          "APS JSON",
          "aps"
        ],
        "extensions": [
          ".aps.json"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "aps-markdown",
        "aliases": [
          "APS Markdown",
          "aps-md"
        ],
        "extensions": [
          ".aps.md"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "rego",
        "aliases": [
          "Rego",
          "OPA Rego"
        ],
        "extensions": [
          ".rego"
        ],
        "configuration": "./syntaxes/rego-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "aps-markdown",
        "scopeName": "text.markdown.aps",
        "path": "./syntaxes/aps.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.frontmatter.aps": "yaml"
        }
      },
      {
        "language": "rego",
        "scopeName": "source.rego",
        "path": "./syntaxes/rego.tmLanguage.json"
      }
    ],
    "problemMatchers": [
      {
        "name": "anvil",
        "owner": "anvil",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.+):(\\d+):(\\d+):\\s+(error|warning|info):\\s+(.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm build:prod",
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --external:eslint --external:jiti --external:@eslint/* --external:dependency-cruiser --format=cjs --platform=node --sourcemap",
    "build:prod": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --external:eslint --external:jiti --external:@eslint/* --external:dependency-cruiser --format=cjs --platform=node --minify",
    "watch": "pnpm build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "dependencies": {
    "@eddacraft/anvil-core": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "^1.110.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.27.4",
    "vitest": "^4.1.0"
  }
}
