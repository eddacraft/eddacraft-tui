{
  "name": "eslint-plugin-anvil",
  "version": "0.3.0-beta",
  "description": "ESLint rules for Anvil test quality enforcement",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "anvil",
    "testing"
  ],
  "peerDependencies": {
    "eslint": ">=8.0.0"
  },
  "devDependencies": {
    "@types/eslint": "^9.6.1",
    "@typescript-eslint/parser": "^8.60.0",
    "@typescript-eslint/rule-tester": "^8.60.0",
    "@typescript-eslint/types": "^8.60.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.7"
  }
}
