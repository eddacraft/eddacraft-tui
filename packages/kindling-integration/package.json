{
  "name": "@eddacraft/anvil-kindling-integration",
  "version": "0.1.0",
  "description": "Kindling memory integration contracts for Anvil v1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./query": {
      "types": "./dist/query-contract.d.ts",
      "import": "./dist/query-contract.js"
    },
    "./observation": {
      "types": "./dist/observation-contract.d.ts",
      "import": "./dist/observation-contract.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.0.10",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "keywords": [
    "anvil",
    "kindling",
    "memory",
    "observability",
    "governance"
  ],
  "license": "PROPRIETARY"
}
