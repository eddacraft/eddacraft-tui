{
  "name": "@eddacraft/anvil-driver-client",
  "version": "0.6.0-beta",
  "description": "Shared TS driver-client library for the anvil-intercept daemon — JSON-RPC 2.0 over NDJSON, transport auto-select (UDS / named pipe), reconnection, reliability-budget quarantine. Per DRVR-001 / ADR-030.",
  "license": "PROPRIETARY",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --testNamePattern 'integration'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "vitest": "^4.1.8"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "anvil",
    "driver",
    "client",
    "json-rpc",
    "ndjson"
  ]
}
