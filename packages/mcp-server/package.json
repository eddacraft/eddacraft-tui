{
  "name": "@eddacraft/anvil-mcp-server",
  "version": "0.3.3-beta",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "bin": {
      "anvil-mcp-server": "./dist/bin.js",
      "anvil-mcp-server-http": "./dist/bin-http.js"
    }
  },
  "exports": {
    ".": "./dist/index.js",
    "./config": "./dist/config/index.js"
  },
  "scripts": {
