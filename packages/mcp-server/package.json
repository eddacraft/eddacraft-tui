    "start": "node dist/bin.js"
  },
  "dependencies": {
    "@eddacraft/anvil-core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^5.1.0",
    "zod": "^4.3.6",
    "@eddacraft/anvil-runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "vitest": "^4.1.5"
  }
}
