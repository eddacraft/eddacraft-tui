{
  "name": "@eddacraft/transactional",
  "version": "0.3.0-beta",
  "description": "Shared transactional email templates for eddacraft",
  "type": "module",
  "main": "./dist/emails/index.js",
  "types": "./dist/emails/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/emails/index.d.ts",
      "import": "./dist/emails/index.js"
    },
    "./emails": {
      "types": "./dist/emails/index.d.ts",
      "import": "./dist/emails/index.js"
    }
  },
  "files": [
    "dist",
    "emails"
  ],
  "scripts": {
    "dev": "email dev --dir emails",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-email": "^6.5.0"
  },
  "devDependencies": {
    "@react-email/ui": "^6.5.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "~6.0.3"
  },
  "license": "PROPRIETARY"
}
