{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Anvil Base",
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022"
  },
  "exclude": [
    "node_modules",
    "dist",
    ".nx",
    "tmp",
    "coverage",
    "playwright-report",
    "test-results"
  ]
}
