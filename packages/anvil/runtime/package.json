{
  "name": "@eddacraft/anvil-runtime",
  "version": "0.6.2-beta",
  "description": "Feature-flag resolution for anvil API and documentation services",
  "keywords": [
    "anvil",
    "orchestration",
    "runtime"
  ],
  "license": "PROPRIETARY",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./feature-flags": {
      "types": "./dist/feature-flags/index.d.ts",
      "import": "./dist/feature-flags/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\" && tsc --build tsconfig.lib.json --force",
    "test": "node --test ../../../scripts/ci/legacy-runtime-retirement.test.mjs && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@eddacraft/anvil-contracts": "workspace:*",
    "@eddacraft/anvil-core": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^4.1.8"
  }
}
