{
  "name": "@anvil/runtime",
  "version": "0.0.1",
  "description": "Orchestration and I/O depending on core, ports, contracts",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./gate": {
      "types": "./dist/gate/index.d.ts",
      "import": "./dist/gate/index.js"
    },
    "./cache": {
      "types": "./dist/cache/index.d.ts",
      "import": "./dist/cache/index.js"
    },
    "./watch": {
      "types": "./dist/watch/index.d.ts",
      "import": "./dist/watch/index.js"
    },
    "./export": {
      "types": "./dist/export/index.d.ts",
      "import": "./dist/export/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anvil/contracts": "workspace:*",
    "@anvil/core": "workspace:*",
    "chokidar": "^4.0.3",
    "eslint": "^9.17.0",
    "glob": "^13.0.0",
    "minimatch": "^9.0.5",
    "shell-quote": "^1.8.1",
    "tar": "^7.4.3",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/shell-quote": "^1.7.1",
    "vitest": "^4.0.17"
  },
  "keywords": [
    "anvil",
    "runtime",
    "orchestration"
  ],
  "license": "MIT"
}
