{
  "name": "@eddacraft/anvil-runtime",
  "version": "0.1.0",
  "description": "Orchestration and I/O depending on core, ports, contracts",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./gate": {
      "types": "./dist/gate/index.d.ts",
      "import": "./dist/gate/index.js"
    },
    "./cache": {
      "types": "./dist/cache/index.d.ts",
      "import": "./dist/cache/index.js"
    },
    "./watch": {
      "types": "./dist/watch/index.d.ts",
      "import": "./dist/watch/index.js"
    },
    "./export": {
      "types": "./dist/export/index.d.ts",
      "import": "./dist/export/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@eddacraft/anvil-contracts": "workspace:*",
    "@eddacraft/anvil-core": "workspace:*",
    "chokidar": "^5.0.0",
    "eslint": "^9.39.2",
    "glob": "13.0.0",
    "minimatch": "^10.1.1",
    "shell-quote": "^1.8.3",
    "tar": "^7.5.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/shell-quote": "^1.7.5",
    "vitest": "^4.0.18"
  },
  "keywords": [
    "anvil",
    "runtime",
    "orchestration"
  ],
  "license": "PROPRIETARY"
}
