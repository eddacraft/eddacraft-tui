{
  "name": "@eddacraft/anvil-runtime",
  "version": "0.1.0",
  "description": "Runtime orchestration layer for Anvil — gate runner, file watching, caching, exports",
  "license": "PROPRIETARY",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./gate": {
      "types": "./dist/gate/index.d.ts",
      "import": "./dist/gate/index.js"
    },
    "./cache": {
      "types": "./dist/cache/index.d.ts",
      "import": "./dist/cache/index.js"
    },
    "./watch": {
      "types": "./dist/watch/index.d.ts",
      "import": "./dist/watch/index.js"
    },
    "./export": {
      "types": "./dist/export/index.d.ts",
      "import": "./dist/export/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@eddacraft/anvil-core": "workspace:*",
    "@eddacraft/anvil-policy": "workspace:*",
    "chokidar": "^5.0.0",
    "eslint": "^10.2.0",
    "glob": "^13.0.0",
    "minimatch": "^10.2.5",
    "shell-quote": "^1.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/shell-quote": "^1.7.5",
    "vitest": "^4.1.3"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "anvil",
    "runtime",
    "orchestration"
  ]
}
