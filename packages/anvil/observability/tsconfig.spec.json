{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "composite": false,
    "declarationMap": false,
    "noEmit": true,
    "types": ["vitest/globals", "vitest/importMeta", "node"]
  },
  "include": ["vitest.config.ts", "src/**/*.test.ts", "src/**/*.spec.ts", "src/**/*.d.ts"],
  "exclude": ["node_modules", "dist"]
}
