{
  "name": "@eddacraft/anvil-core",
  "version": "0.6.2-beta",
  "description": "Core domain logic for Anvil — schemas, types, analysis, and validation",
  "license": "PROPRIETARY",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./architecture": {
      "types": "./dist/architecture/index.d.ts",
      "import": "./dist/architecture/index.js"
    },
    "./validation": {
      "types": "./dist/validation/index.d.ts",
      "import": "./dist/validation/index.js"
    },
    "./warnings": {
      "types": "./dist/warnings/index.d.ts",
      "import": "./dist/warnings/index.js"
    },
    "./explain": {
      "types": "./dist/explain/index.d.ts",
      "import": "./dist/explain/index.js"
    },
    "./provenance": {
      "types": "./dist/provenance/index.d.ts",
      "import": "./dist/provenance/index.js"
    },
    "./crypto": {
      "types": "./dist/crypto/index.d.ts",
      "import": "./dist/crypto/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "patterns:compile": "tsx scripts/compile-patterns.ts",
    "patterns:check": "tsx scripts/compile-patterns.ts --check",
    "prepack": "node -e \"const f=require('node:fs');const p=require('node:path');const src=p.resolve(__dirname,'../../../patterns/compiled/registry.json');const dest=p.resolve(__dirname,'patterns/compiled/registry.json');if(!f.existsSync(src))throw new Error('registry missing: '+src);f.mkdirSync(p.dirname(dest),{recursive:true});f.copyFileSync(src,dest);\""
  },
  "dependencies": {
    "json-schema": "^0.4.0",
    "minimatch": "^10.2.5",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/json-schema": "^7.0.15",
    "tsx": "^4.22.4",
    "vitest": "^4.1.8"
  },
  "files": [
    "dist",
    "patterns/compiled/registry.json",
    "README.md"
  ],
  "keywords": [
    "anvil",
    "core",
    "domain"
  ]
}
