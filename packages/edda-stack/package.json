{
  "name": "@eddacraft/anvil-edda-stack",
  "version": "0.3.0-beta",
  "description": "Kindling · Ember · Edda memory stack for Anvil",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    },
    "./contracts/*": {
      "types": "./dist/contracts/*.d.ts",
      "import": "./dist/contracts/*.js"
    },
    "./ember": {
      "types": "./dist/ember/index.d.ts",
      "import": "./dist/ember/index.js"
    },
    "./edda": {
      "types": "./dist/edda/index.d.ts",
      "import": "./dist/edda/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "uuid": "^13.0.0",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "typescript": "~6.0.2",
    "uuid": "^13.0.0",
    "vitest": "^4.1.4"
  },
  "keywords": [
    "anvil",
    "edda",
    "ember",
    "kindling",
    "memory",
    "observability"
  ],
  "license": "PROPRIETARY"
}
