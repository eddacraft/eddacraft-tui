{
  "name": "@eddacraft/anvil-edda-stack",
  "version": "0.11.0-beta",
  "description": "Kindling · Ember · Edda memory stack for Anvil",
  "keywords": [
    "anvil",
    "edda",
    "ember",
    "kindling",
    "memory",
    "observability"
  ],
  "license": "PROPRIETARY",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    },
    "./contracts/*": {
      "types": "./dist/contracts/*.d.ts",
      "import": "./dist/contracts/*.js"
    },
    "./edda": {
      "types": "./dist/edda/index.d.ts",
      "import": "./dist/edda/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\" && tsc --build --force",
    "test": "vitest",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "uuid": "^14.0.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "~6.0.3",
    "uuid": "^14.0.1",
    "vitest": "^4.1.8"
  }
}
