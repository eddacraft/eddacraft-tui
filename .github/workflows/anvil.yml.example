# Anvil Check Workflow
# Copy this file to anvil.yml to enable Anvil checks on your repository.
#
# For more information, see: .github/actions/anvil-check/README.md

name: Anvil Check

on:
  pull_request:
    types: [opened, synchronize, reopened]
  push:
    branches: [main]

# Required permissions for PR comments and status checks
permissions:
  contents: read
  pull-requests: write
  statuses: write
  checks: write

jobs:
  anvil-check:
    name: Anvil Check
    runs-on: ubuntu-latest
    
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Run Anvil Check
        id: anvil
        uses: ./.github/actions/anvil-check
        # Node version is auto-detected from .node-version, .nvmrc, or package.json
        # Uncomment below to customise:
        # with:
        #   node-version: '22'           # Explicit Node version
        #   fail-on-warnings: 'true'     # Block PR on warnings
        #   check-type: 'gate'           # Run full gates instead of quick check
        #   github_token: ${{ secrets.GH_AUTH_TOKEN }}  # Use custom GitHub token

      # Optional: Use outputs in subsequent steps
      - name: Report Results
        if: always()
        run: |
          echo "### Anvil Check Results" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "- Warnings: ${{ steps.anvil.outputs.warnings-count }}" >> $GITHUB_STEP_SUMMARY
          echo "- Errors: ${{ steps.anvil.outputs.errors-count }}" >> $GITHUB_STEP_SUMMARY

