{
  "version": "${VERSION}",
  "description": "Deterministic guardrails for AI-assisted development workflows",
  "homepage": "https://eddacraft.ai",
  "license": "Proprietary",
  "architecture": {
    "64bit": {
      "url": "https://github.com/eddacraft/anvil/releases/download/${RELEASE_TAG}/eddacraft-anvil-x86_64-pc-windows-msvc.zip",
      "hash": "${X64_SHA256}"
    },
    "arm64": {
      "url": "https://github.com/eddacraft/anvil/releases/download/${RELEASE_TAG}/eddacraft-anvil-aarch64-pc-windows-msvc.zip",
      "hash": "${ARM64_SHA256}"
    }
  },
  "bin": "anvil.exe",
  "checkver": {
    "github": "https://github.com/eddacraft/anvil",
    "regex": "v([\\d.]+(?:-beta[\\w.]*)?)"
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/eddacraft/anvil/releases/download/v$version/eddacraft-anvil-x86_64-pc-windows-msvc.zip",
        "hash": {
          "url": "$url.sha256"
        }
      },
      "arm64": {
        "url": "https://github.com/eddacraft/anvil/releases/download/v$version/eddacraft-anvil-aarch64-pc-windows-msvc.zip",
        "hash": {
          "url": "$url.sha256"
        }
      }
    }
  }
}
