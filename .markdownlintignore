# Ignore node_modules across all packages (monorepo structure)
**/node_modules/**

# Ignore build artifacts and generated files
dist/
.nx/
*.tsbuildinfo

# Ignore test fixtures (they may have intentional formatting issues for testing)
**/fixtures/**

# Ignore test reports
playwright-report/
test-results/
coverage/

# Ignore local benchmark output (gitignored, never committed; mirrors .gitignore)
benchmark-results/

