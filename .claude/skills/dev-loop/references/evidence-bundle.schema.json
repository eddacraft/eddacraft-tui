{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eddacraft.dev/schemas/dev-loop/evidence-bundle.schema.json",
  "title": "Development Loop Evidence Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "target",
    "baseRevision",
    "headRevision",
    "risk",
    "contractSources",
    "repositoryState",
    "commands",
    "findings",
    "decision",
    "producer",
    "createdAt"
  ],
  "properties": {
    "version": { "const": 2 },
    "target": { "type": "string", "minLength": 1 },
    "baseRevision": { "type": "string", "minLength": 1 },
    "headRevision": { "type": "string", "minLength": 1 },
    "risk": { "enum": ["low", "standard", "high", "critical"] },
    "contractSources": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "uniqueItems": true
    },
    "repositoryState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["treeDigest", "dirty", "environmentDigest"],
      "properties": {
        "treeDigest": { "type": "string", "minLength": 1 },
        "dirty": { "type": "boolean" },
        "environmentDigest": { "type": "string", "minLength": 1 }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "argv",
          "cwd",
          "exitCode",
          "durationMs",
          "stdoutDigest",
          "stderrDigest",
          "runAt"
        ],
        "properties": {
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "cwd": { "type": "string", "minLength": 1 },
          "exitCode": { "type": "integer" },
          "durationMs": { "type": "integer", "minimum": 0 },
          "stdoutDigest": { "type": "string", "minLength": 1 },
          "stderrDigest": { "type": "string", "minLength": 1 },
          "logRef": { "type": ["string", "null"] },
          "summary": { "type": ["string", "null"] },
          "runAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "requirement", "evidence", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["critical", "major", "minor", "advisory"] },
          "requirement": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 },
          "reproduction": { "type": ["string", "null"] },
          "status": { "enum": ["open", "resolved", "accepted", "disputed"] }
        }
      }
    },
    "overrides": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "decision": {
      "enum": ["pass", "pass-with-advisories", "repair-required", "blocked", "under-specified"]
    },
    "producer": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
