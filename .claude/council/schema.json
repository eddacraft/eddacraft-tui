{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Council Review Session Schema",
  "description": "Data model for local-first Council review sessions, findings, evidence, and publication",

  "definitions": {
    "session": {
      "type": "object",
      "description": "A Council review session — the top-level container for a review",
      "required": ["id", "mode", "status", "target", "reviewerPack", "createdAt"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^council-[a-f0-9]{8}$",
          "description": "Unique session identifier (council-{8 hex chars})"
        },
        "mode": {
          "type": "string",
          "enum": ["streaming", "batch"],
          "description": "Review mode"
        },
        "status": {
          "type": "string",
          "enum": ["active", "paused", "converged", "published", "abandoned"],
          "description": "Session lifecycle state"
        },
        "target": {
          "$ref": "#/definitions/reviewTarget"
        },
        "reviewerPack": {
          "type": "string",
          "enum": ["quick", "standard", "full"],
          "description": "Reviewer pack used for this session"
        },
        "reviewers": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Agent names that participated in review"
        },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/definitions/finding" },
          "description": "All findings in this session"
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/definitions/evidence" },
          "description": "Validation evidence attached to this session"
        },
        "waivers": {
          "type": "array",
          "items": { "$ref": "#/definitions/waiver" },
          "description": "Accepted-risk waivers"
        },
        "events": {
          "type": "array",
          "items": { "$ref": "#/definitions/sessionEvent" },
          "description": "Chronological event log"
        },
        "summary": {
          "$ref": "#/definitions/publicationSummary",
          "description": "Generated publication summary (populated on publish)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "convergedAt": {
          "type": "string",
          "format": "date-time"
        },
        "parentSession": {
          "type": "string",
          "description": "ID of parent session if this is a continuation/escalation"
        }
      }
    },

    "reviewTarget": {
      "type": "object",
      "description": "What is being reviewed",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["worktree", "staged", "branch", "files", "commit"],
          "description": "Target scope"
        },
        "branch": {
          "type": "string",
          "description": "Branch name (for branch targets)"
        },
        "baseBranch": {
          "type": "string",
          "description": "Base branch for comparison"
        },
        "files": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Specific files under review"
        },
        "commit": {
          "type": "string",
          "description": "Commit SHA (for commit targets)"
        },
        "diffStats": {
          "type": "object",
          "properties": {
            "filesChanged": { "type": "integer" },
            "insertions": { "type": "integer" },
            "deletions": { "type": "integer" }
          }
        }
      }
    },

    "finding": {
      "type": "object",
      "description": "A single review finding",
      "required": ["id", "severity", "category", "description", "source", "status"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^C-\\d{3}$",
          "description": "Finding ID within session (C-001, C-002, ...)"
        },
        "severity": {
          "type": "string",
          "enum": ["critical", "major", "minor", "nit"],
          "description": "Finding severity"
        },
        "category": {
          "type": "string",
          "enum": [
            "security",
            "correctness",
            "edge-case",
            "performance",
            "architecture",
            "style",
            "test-coverage",
            "documentation"
          ],
          "description": "Finding category"
        },
        "description": {
          "type": "string",
          "description": "Clear description of the issue"
        },
        "file": {
          "type": "string",
          "description": "File path (relative to repo root)"
        },
        "line": {
          "type": "integer",
          "minimum": 1,
          "description": "Line number"
        },
        "suggestion": {
          "type": "string",
          "description": "Suggested fix or improvement"
        },
        "source": {
          "type": "string",
          "description": "Reviewer agent that produced this finding"
        },
        "status": {
          "type": "string",
          "enum": ["open", "fixed", "deferred", "waived", "dismissed"],
          "description": "Current resolution state"
        },
        "resolution": {
          "type": "string",
          "description": "How the finding was resolved (commit ref, justification, etc.)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "resolvedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },

    "evidence": {
      "type": "object",
      "description": "Validation evidence attached to a session",
      "required": ["id", "type", "description"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^E-\\d{3}$",
          "description": "Evidence ID (E-001, E-002, ...)"
        },
        "type": {
          "type": "string",
          "enum": ["test", "lint", "security-scan", "build", "manual", "command"],
          "description": "Type of evidence"
        },
        "description": {
          "type": "string",
          "description": "What was validated"
        },
        "command": {
          "type": "string",
          "description": "Command that produced this evidence"
        },
        "result": {
          "type": "string",
          "enum": ["pass", "fail", "partial", "skipped"],
          "description": "Evidence outcome"
        },
        "output": {
          "type": "string",
          "description": "Abbreviated output or reference"
        },
        "findingIds": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Findings this evidence validates"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },

    "waiver": {
      "type": "object",
      "description": "Accepted-risk waiver for a finding",
      "required": ["findingId", "reason", "acceptedBy"],
      "properties": {
        "findingId": {
          "type": "string",
          "description": "ID of the waived finding"
        },
        "reason": {
          "type": "string",
          "description": "Justification for accepting the risk"
        },
        "acceptedBy": {
          "type": "string",
          "description": "Who accepted (user or agent name)"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "description": "Optional expiration for time-bound waivers"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },

    "sessionEvent": {
      "type": "object",
      "description": "A timestamped event in the session lifecycle",
      "required": ["type", "timestamp"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "session_created",
            "session_resumed",
            "session_paused",
            "session_abandoned",
            "session_closed",
            "reviewer_started",
            "reviewer_completed",
            "finding_added",
            "finding_resolved",
            "evidence_added",
            "waiver_added",
            "escalated",
            "converged",
            "published"
          ],
          "description": "Event type"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "detail": {
          "type": "string",
          "description": "Human-readable detail"
        },
        "data": {
          "type": "object",
          "description": "Structured event data"
        }
      }
    },

    "publicationSummary": {
      "type": "object",
      "description": "Publication-ready review summary for PR/commit surfaces",
      "required": ["sessionId", "mode", "reviewerPack"],
      "properties": {
        "sessionId": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "enum": ["streaming", "batch"]
        },
        "reviewerPack": {
          "type": "string",
          "enum": ["quick", "standard", "full"]
        },
        "reviewers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "target": {
          "type": "string",
          "description": "Human-readable target description"
        },
        "findingCounts": {
          "type": "object",
          "properties": {
            "total": { "type": "integer" },
            "fixed": { "type": "integer" },
            "deferred": { "type": "integer" },
            "waived": { "type": "integer" },
            "dismissed": { "type": "integer" },
            "open": { "type": "integer" }
          }
        },
        "severityCounts": {
          "type": "object",
          "properties": {
            "critical": { "type": "integer" },
            "major": { "type": "integer" },
            "minor": { "type": "integer" },
            "nit": { "type": "integer" }
          }
        },
        "notableWaivers": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Human-readable waiver summaries"
        },
        "evidenceSummary": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Human-readable evidence summaries"
        },
        "verdict": {
          "type": "string",
          "enum": ["clean", "clean-with-waivers", "open-findings", "not-converged"],
          "description": "Overall review verdict"
        },
        "markdownBody": {
          "type": "string",
          "description": "Pre-rendered markdown for PR body injection"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
