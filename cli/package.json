  "repository": {
    "type": "git",
    "url": "https://github.com/EddaCraft/anvil-001.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/EddaCraft/anvil-001/issues"
  },
  "homepage": "https://github.com/EddaCraft/anvil-001#readme",
  "author": "EddaCraft",
  "dependencies": {
    "@anvil/core": "workspace:*",
    "@anvil/adapters": "workspace:*",
    "commander": "^14.0.1",
    "chalk": "^5.3.0",
    "ora": "^9.0.0",
    "inquirer": "^12.10.0",
    "fs-extra": "^11.2.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.7"
  }
}
