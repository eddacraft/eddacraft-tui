{
  "name": "@anvil/cli",
  "version": "0.0.0",
  "description": "CLI for Anvil - deterministic development automation platform",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "anvil": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "anvil",
    "automation",
    "validation",
    "quality-gates",
    "ai-safety",
    "speckit",
    "planning"
