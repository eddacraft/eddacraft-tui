{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.eddacraft.ai/anvil/schemas/anvil-insights.v2.json",
  "title": "Anvil Insights v2",
  "description": "The anvil.insights.v1 rolling-window document extended with the cumulative value aggregate. Emitted by `anvil insights --cumulative --json`; the default `--json` output remains anvil.insights.v1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "window_start",
    "window_end",
    "witness_events_observed",
    "total_saves_observed",
    "findings_raised",
    "suppressions_applied",
    "suppressions_resolved",
    "baseline_edges_added",
    "daemon_uptime_percentage",
    "cumulative"
  ],
  "properties": {
    "schema_version": {
      "const": "anvil.insights.v2"
    },
    "window_start": {
      "type": "string",
      "format": "date-time"
    },
    "window_end": {
      "type": "string",
      "format": "date-time"
    },
    "witness_events_observed": {
      "type": "integer",
      "minimum": 0
    },
    "total_saves_observed": {
      "type": "integer",
      "minimum": 0
    },
    "findings_raised": {
      "type": "integer",
      "minimum": 0
    },
    "suppressions_applied": {
      "type": "integer",
      "minimum": 0
    },
    "suppressions_resolved": {
      "type": "integer",
      "minimum": 0
    },
    "baseline_edges_added": {
      "type": "integer",
      "minimum": 0
    },
    "daemon_uptime_percentage": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "cumulative": {
      "type": "object",
      "additionalProperties": false,
      "description": "Counts and evidence-window bounds only. `since`/`as_of` are the evidence's own bounds (null when nothing is recorded yet); no generation timestamp appears anywhere, so identical inputs produce identical documents.",
      "required": [
        "since",
        "as_of",
        "witness_events_total",
        "witness_events_last_30_days",
        "witness_events_last_90_days",
        "save_time"
      ],
      "properties": {
        "since": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "as_of": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "witness_events_total": {
          "type": "integer",
          "minimum": 0
        },
        "witness_events_last_30_days": {
          "type": "integer",
          "minimum": 0
        },
        "witness_events_last_90_days": {
          "type": "integer",
          "minimum": 0
        },
        "save_time": {
          "type": "object",
          "additionalProperties": false,
          "description": "Save-time protection counts, valid only over the retained sidecar window named by window_start/window_end (the sidecar has bounded retention; these are never all-time claims).",
          "required": [
            "window_start",
            "window_end",
            "evaluations_observed",
            "risky_writes_flagged",
            "writes_blocked",
            "secret_findings_caught",
            "fences_engaged"
          ],
          "properties": {
            "window_start": {
              "type": ["string", "null"],
              "format": "date-time"
            },
            "window_end": {
              "type": ["string", "null"],
              "format": "date-time"
            },
            "evaluations_observed": {
              "type": "integer",
              "minimum": 0
            },
            "risky_writes_flagged": {
              "type": "integer",
              "minimum": 0
            },
            "writes_blocked": {
              "type": "integer",
              "minimum": 0
            },
            "secret_findings_caught": {
              "type": "integer",
              "minimum": 0
            },
            "fences_engaged": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
