{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.eddacraft.ai/anvil/schemas/workflow-session-event.v1.schema.json",
  "title": "Anvil workflow session and event schema",
  "type": "object",
  "oneOf": [{ "$ref": "#/$defs/workflowSession" }, { "$ref": "#/$defs/workflowEvent" }],
  "$defs": {
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actorId", "actorType"],
      "properties": {
        "actorId": { "type": "string", "minLength": 1 },
        "actorType": {
          "type": "string",
          "enum": ["human", "agent", "ci", "hook", "system"]
        },
        "role": { "type": "string", "minLength": 1 },
        "runtime": { "type": "string", "minLength": 1 }
      }
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "type": "string", "enum": ["sha256"] },
        "value": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "mediaType": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceType", "referenceKind", "reference"],
      "properties": {
        "evidenceType": {
          "type": "string",
          "enum": ["command", "ci-check", "pr", "review", "release-record", "file", "url"]
        },
        "referenceKind": {
          "type": "string",
          "enum": ["safe-reference", "redacted-summary", "digest-only"]
        },
        "reference": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": ["pass", "fail", "skipped", "pending", "unknown"]
        },
        "digest": { "$ref": "#/$defs/digest" }
      },
      "allOf": [
        {
          "if": { "properties": { "referenceKind": { "const": "digest-only" } } },
          "then": { "required": ["digest"] }
        }
      ]
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "scope", "decidedBy", "decidedAt"],
      "properties": {
        "decision": { "type": "string", "enum": ["approved", "rejected", "revoked"] },
        "scope": { "type": "string", "minLength": 1 },
        "decidedBy": { "$ref": "#/$defs/actor" },
        "decidedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "rationale": { "type": "string" }
      }
    },
    "errorInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["errorClass"],
      "properties": {
        "errorClass": {
          "type": "string",
          "enum": [
            "validation-failed",
            "tool-failed",
            "ci-failed",
            "review-blocked",
            "approval-missing",
            "merge-conflict",
            "release-failed",
            "unknown"
          ]
        },
        "message": { "type": "string" },
        "retryable": { "type": "boolean" },
        "recoveryHint": { "type": "string" }
      }
    },
    "stateTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "reason": { "type": "string" }
      }
    },
    "toolInvocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toolName"],
      "properties": {
        "toolName": { "type": "string", "minLength": 1 },
        "commandDigest": { "$ref": "#/$defs/digest" },
        "inputDigest": { "$ref": "#/$defs/digest" },
        "outputDigest": { "$ref": "#/$defs/digest" },
        "exitCode": { "type": "integer", "minimum": 0 },
        "durationMs": { "type": "integer", "minimum": 0 }
      }
    },
    "validationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": ["pass", "fail", "skipped", "pending", "unknown"]
        },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    },
    "repoReality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "baseBranch", "headBranch", "headSha"],
      "properties": {
        "repo": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "baseBranch": { "type": "string", "minLength": 1 },
        "headBranch": { "type": "string", "minLength": 1 },
        "headSha": { "type": "string", "pattern": "^[a-f0-9]{7,40}$" },
        "changedFiles": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "changedSincePlan": { "type": "boolean" }
      }
    },
    "workflowEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "recordType",
        "eventId",
        "timestamp",
        "eventType",
        "workflowId",
        "sessionId",
        "actor",
        "apsItems"
      ],
      "properties": {
        "schemaVersion": { "const": "workflow-session-event/v1" },
        "recordType": { "const": "workflowEvent" },
        "eventId": { "type": "string", "minLength": 1 },
        "timestamp": { "type": "string", "format": "date-time" },
        "eventType": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$" },
        "workflowId": { "type": "string", "minLength": 1 },
        "sessionId": { "type": "string", "minLength": 1 },
        "actor": { "$ref": "#/$defs/actor" },
        "apsItems": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]+-[0-9]{3}$" },
          "minItems": 1,
          "uniqueItems": true
        },
        "branch": { "type": "string", "minLength": 1 },
        "sha": { "type": "string", "pattern": "^[a-f0-9]{7,40}$" },
        "stateTransition": { "$ref": "#/$defs/stateTransition" },
        "toolInvocation": { "$ref": "#/$defs/toolInvocation" },
        "inputDigest": { "$ref": "#/$defs/digest" },
        "outputDigest": { "$ref": "#/$defs/digest" },
        "validationResult": { "$ref": "#/$defs/validationResult" },
        "error": { "$ref": "#/$defs/errorInfo" },
        "approval": { "$ref": "#/$defs/approval" },
        "evidence": { "$ref": "#/$defs/evidence" },
        "traceparent": {
          "type": "string",
          "pattern": "^00-(?!0{32})[0-9a-f]{32}-(?!0{16})[0-9a-f]{16}-[0-9a-f]{2}$"
        },
        "payloadDigest": { "$ref": "#/$defs/digest" }
      },
      "allOf": [
        {
          "if": { "properties": { "eventType": { "pattern": "^approval\\." } } },
          "then": {
            "required": ["approval"],
            "not": { "required": ["validationResult"] },
            "properties": {
              "eventType": {
                "enum": ["approval.granted", "approval.rejected", "approval.revoked"]
              }
            }
          }
        },
        {
          "if": { "properties": { "eventType": { "const": "approval.granted" } } },
          "then": {
            "required": ["approval"],
            "properties": {
              "approval": {
                "properties": { "decision": { "const": "approved" } }
              }
            }
          }
        },
        {
          "if": { "properties": { "eventType": { "const": "approval.rejected" } } },
          "then": {
            "required": ["approval"],
            "properties": {
              "approval": {
                "properties": { "decision": { "const": "rejected" } }
              }
            }
          }
        },
        {
          "if": { "properties": { "eventType": { "const": "approval.revoked" } } },
          "then": {
            "required": ["approval"],
            "properties": {
              "approval": {
                "properties": { "decision": { "const": "revoked" } }
              }
            }
          }
        },
        {
          "if": { "properties": { "eventType": { "pattern": "^validation\\." } } },
          "then": {
            "required": ["validationResult"],
            "not": { "required": ["approval"] },
            "properties": {
              "eventType": {
                "enum": [
                  "validation.passed",
                  "validation.failed",
                  "validation.skipped",
                  "validation.pending"
                ]
              }
            }
          }
        },
        {
          "if": { "properties": { "eventType": { "const": "validation.failed" } } },
          "then": {
            "required": ["validationResult"],
            "properties": {
              "validationResult": {
                "properties": { "status": { "const": "fail" } }
              }
            }
          }
        },
        {
          "if": { "properties": { "eventType": { "const": "validation.passed" } } },
          "then": {
            "required": ["validationResult"],
            "properties": {
              "validationResult": {
                "properties": { "status": { "const": "pass" } }
              }
            }
          }
        },
        {
          "if": { "properties": { "eventType": { "const": "validation.skipped" } } },
          "then": {
            "required": ["validationResult"],
            "properties": {
              "validationResult": {
                "properties": { "status": { "const": "skipped" } }
              }
            }
          }
        },
        {
          "if": { "properties": { "eventType": { "const": "validation.pending" } } },
          "then": {
            "required": ["validationResult"],
            "properties": {
              "validationResult": {
                "properties": { "status": { "const": "pending" } }
              }
            }
          }
        },
        {
          "if": { "properties": { "eventType": { "pattern": "^error\\." } } },
          "then": { "required": ["error"] }
        }
      ]
    },
    "workflowSession": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "recordType",
        "sessionId",
        "sessionKind",
        "workflowId",
        "status",
        "currentState",
        "apsItems",
        "repoReality",
        "actors",
        "events"
      ],
      "properties": {
        "schemaVersion": { "const": "workflow-session-event/v1" },
        "recordType": { "const": "workflowSession" },
        "sessionId": { "type": "string", "minLength": 1 },
        "sessionKind": {
          "type": "string",
          "enum": [
            "code-review",
            "planning",
            "pre-execution",
            "release",
            "recovery",
            "implementation"
          ]
        },
        "workflowId": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": ["open", "converged", "published", "complete", "blocked", "failed", "abandoned"]
        },
        "currentState": { "type": "string", "minLength": 1 },
        "apsItems": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]+-[0-9]{3}$" },
          "minItems": 1,
          "uniqueItems": true
        },
        "repoReality": { "$ref": "#/$defs/repoReality" },
        "actors": {
          "type": "array",
          "items": { "$ref": "#/$defs/actor" },
          "minItems": 1
        },
        "events": {
          "type": "array",
          "items": {
            "oneOf": [{ "$ref": "#/$defs/workflowEvent" }, { "type": "string", "minLength": 1 }]
          }
        },
        "playbooks": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "relevantDecisions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "traceparent": {
          "type": "string",
          "pattern": "^00-(?!0{32})[0-9a-f]{32}-(?!0{16})[0-9a-f]{16}-[0-9a-f]{2}$"
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "proceed",
              "amend",
              "split",
              "replan",
              "block",
              "approve",
              "needs-changes",
              "reject",
              "waived",
              "candidate-ready",
              "publish-approved",
              "verify-pass",
              "verify-fail",
              "rollback-required",
              "recovery-complete"
            ]
          },
          "uniqueItems": true
        },
        "waivers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["waiverId", "risk", "approvedBy", "rationale"],
            "properties": {
              "waiverId": { "type": "string", "minLength": 1 },
              "risk": { "type": "string", "minLength": 1 },
              "approvedBy": { "$ref": "#/$defs/actor" },
              "rationale": { "type": "string", "minLength": 1 },
              "expiresAt": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    }
  }
}
