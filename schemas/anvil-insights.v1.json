{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.eddacraft.ai/anvil/schemas/anvil-insights.v1.json",
  "title": "Anvil Insights v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "window_start",
    "window_end",
    "witness_events_observed",
    "total_saves_observed",
    "findings_raised",
    "suppressions_applied",
    "suppressions_resolved",
    "baseline_edges_added",
    "daemon_uptime_percentage"
  ],
  "properties": {
    "schema_version": {
      "const": "anvil.insights.v1"
    },
    "window_start": {
      "type": "string",
      "format": "date-time"
    },
    "window_end": {
      "type": "string",
      "format": "date-time"
    },
    "witness_events_observed": {
      "type": "integer",
      "minimum": 0
    },
    "total_saves_observed": {
      "type": "integer",
      "minimum": 0
    },
    "findings_raised": {
      "type": "integer",
      "minimum": 0
    },
    "suppressions_applied": {
      "type": "integer",
      "minimum": 0
    },
    "suppressions_resolved": {
      "type": "integer",
      "minimum": 0
    },
    "baseline_edges_added": {
      "type": "integer",
      "minimum": 0
    },
    "daemon_uptime_percentage": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    }
  }
}
