# DEVENV-002 (ADR-057): relocate the Rust `target/` off the Projects mount.
#
# Per-worktree ~100 GB `target/` dirs fill the Projects mount (nvme1n1p1) and hit
# ENOSPC; /home has space. direnv expands ${HOME} and `basename "$PWD"` is this
# worktree's directory name, so each worktree gets an isolated, lock-free target
# dir on /home. Run `direnv allow` once per worktree to enable — until you do,
# direnv prints a loud "blocked" nag on every cd, which is the intended guard
# against silently building onto the full mount.
#
# This is committed and inert in CI (no direnv on runners), so the nx/Azure build
# cache is unaffected. If you use neither direnv nor `wt`, a raw shell builds into
# the in-tree `target/` on the full mount (see `.config/wt.toml` for the wt path);
# reclaim a stray in-tree target with `cargo clean` until DEVENV-004 eviction lands.
export CARGO_TARGET_DIR="${HOME}/.cache/anvil-targets/$(basename "$PWD")"
mkdir -p "${CARGO_TARGET_DIR}"
