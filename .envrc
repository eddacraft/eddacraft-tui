# Move Cargo build output out of each checkout/worktree.
#
# Rust builds can create very large target/ directories. Keeping them inside every
# Anvil worktree quickly fills the Projects mount, while /home has more space.
# The directory name keeps each worktree isolated so parallel builds do not share
# locks or incremental state.
#
# direnv requires explicit approval for every worktree because approvals are
# scoped to the .envrc path and content. Run `direnv allow` in a trusted worktree
# after reviewing this file. Until then, direnv prints a "blocked" warning on cd;
# that is the intended safety gate.
#
# CI does not use direnv, so this only affects local interactive shells. If you do
# not use direnv, Cargo falls back to the in-tree target/ directory. Reclaim any
# accidental in-tree build output with `cargo clean`.
export CARGO_TARGET_DIR="${HOME}/.cache/anvil-targets/$(basename "$PWD")"
mkdir -p "${CARGO_TARGET_DIR}"

# Prefer repo-pinned developer tools over stale global installs.
#
# node_modules/.bin contains the tool versions selected by this checkout (for
# example oxfmt and oxlint). Putting it first means a plain `oxfmt` or `oxlint`
# in a direnv shell uses the project version. If dependencies have not been
# installed yet, PATH_add is harmless.
PATH_add node_modules/.bin
